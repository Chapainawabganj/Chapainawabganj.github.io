<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title + ' | পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি' : 'পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি | PUST' %></title>

    <!-- Google Font: Hind Siliguri & Source Sans Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Source+Sans+Pro:wght@400;600;700&display=fallback" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- Bootstrap 4 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
    <!-- Custom Stylesheet with Navy Blue & Emerald Green -->
    <link rel="stylesheet" href="/CSS/customstylesheet.css?v=2.2" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <style>
        body, h1, h2, h3, h4, h5, h6, .nav-link, button, input, select {
            font-family: 'Hind Siliguri', 'Source Sans Pro', sans-serif;
        }
    </style>
</head>
<body>

    <!-- Top Header / Crest & Identity -->
    <div class="jumbotron-header text-center">
        <div class="container">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-center">
                <div class="mr-md-3 mb-2 mb-md-0">
                    <img id="ImgLogo" src="/Photo/me.png" alt="PUST Logo" style="height: 85px; width: auto;" onerror="this.src='/Photo/me.png'">
                </div>
                <div class="text-center text-md-left">
                    <h2 class="brand-title-bn mb-0">পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়স্থ চাঁপাইনবাবগঞ্জ জেলা সমিতি</h2>
                    <h5 class="brand-title-en mb-0">Chapainabjanj Jelashomiti PUST</h5>
                    <small class="text-muted font-weight-bold" style="font-size: 13px;">
                        <i class="fas fa-map-marker-alt text-danger mr-1"></i> পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয় (PUST), পাবনা-৬৬০০ &bull; ঐক্য, সৌহার্দ্য ও প্রগতি
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light navbar-custom sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand d-lg-none font-weight-bold" href="/home.aspx" style="color: var(--navy-blue);">
                <i class="fas fa-users text-success mr-1"></i> চাঁপাইনবাবগঞ্জ জেলা সমিতি
            </a>

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mr-auto align-items-lg-center" id="mainNavList">
                    <li class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'home') ? 'active' : '' %>">
                        <a class="nav-link" href="/home.aspx"><i class="fas fa-home"></i> হোম</a>
                    </li>
                    <li class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'about') ? 'active' : '' %>">
                        <a class="nav-link" href="/about.aspx">পরিচিতি ও ইতিহাস</a>
                    </li>
                    <li class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'alumnilist') ? 'active' : '' %>">
                        <a class="nav-link" href="/alumnilist.aspx"><i class="fas fa-search text-info mr-1"></i> শিক্ষার্থী ও সদস্য তালিকা</a>
                    </li>
                    <li class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'blood') ? 'active' : '' %>">
                        <a class="nav-link text-danger font-weight-bold" href="/blood_donation.aspx">
                            <i class="fas fa-tint text-danger mr-1 animate__animated animate__pulse animate__infinite"></i> রক্তদান নেটওয়ার্ক
                        </a>
                    </li>
                    <li class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'support') ? 'active' : '' %>">
                        <a class="nav-link" href="/student_support.aspx"><i class="fas fa-hands-helping text-success mr-1"></i> শিক্ষার্থী সহায়তা</a>
                    </li>
                    <li class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'committee') ? 'active' : '' %>">
                        <a class="nav-link" href="/committee.aspx">কার্যনির্বাহী কমিটি</a>
                    </li>
                    <li class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'notice') ? 'active' : '' %>">
                        <a class="nav-link" href="/notice.aspx">নোটিশ ও বিজ্ঞপ্তি</a>
                    </li>

                    <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
                    <li class="nav-item dropdown ml-lg-2" id="adminNavDropdown">
                        <a class="nav-link dropdown-toggle text-danger font-weight-bold" href="#" id="adminMenuDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-shield-alt mr-1"></i> অ্যাডমিন প্যানেল
                        </a>
                        <div class="dropdown-menu shadow border-0" aria-labelledby="adminMenuDropdown">
                            <a class="dropdown-item" href="/membermanagement.aspx"><i class="fas fa-user-check text-success mr-2"></i> শিক্ষার্থী ভেরিফিকেশন ও তালিকা</a>
                            <a class="dropdown-item" href="/admin_update_member.aspx"><i class="fas fa-user-edit text-primary mr-2"></i> তথ্য সংশোধন ও আপডেট</a>
                            <a class="dropdown-item" href="/admin_content.aspx"><i class="fas fa-bullhorn text-info mr-2"></i> নোটিশ ও ফাইল আপলোড</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-danger btn-logout-action" href="/logout"><i class="fas fa-sign-out-alt mr-2"></i> অ্যাডমিন লগআউট</a>
                        </div>
                    </li>
                    <% } %>
                </ul>

                <!-- Action Button & User Area -->
                <ul class="navbar-nav ml-auto align-items-lg-center" id="userNavArea">
                    <li class="nav-item mr-lg-3 my-2 my-lg-0">
                        <a class="nav-link btn-apply font-weight-bold" href="/registration.aspx">
                            <i class="fas fa-user-plus mr-1"></i> সদস্য নিবন্ধন
                        </a>
                    </li>

                    <li class="nav-item" id="userAreaContainer">
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <div class="d-flex align-items-center">
                            <img src="/<%= currentUser.profile_photo || 'Photo/fahim.png' %>" class="rounded-circle mr-2 border border-success" alt="<%= currentUser.full_name %>" height="38" width="38" style="object-fit: cover;" onerror="this.onerror=null; this.src='Photo/fahim.png';" />
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle font-weight-bold text-dark px-1" href="#" id="userDropdown" role="button" data-toggle="dropdown">
                                    <%= currentUser.full_name.split(' ')[0] %>
                                    <span class="badge badge-<%= currentUser.status === 'Active' ? 'success' : 'warning' %> ml-1"><%= currentUser.status === 'Active' ? 'সক্রিয়' : 'পেন্ডিং' %></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right shadow border-0">
                                    <a class="dropdown-item" href="/my_profile.aspx"><i class="fas fa-id-card text-primary mr-2"></i> প্রোফাইল ও ডিজিটাল আইডি</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item text-danger btn-logout-action" href="/logout"><i class="fas fa-sign-out-alt mr-2"></i> লগআউট</a>
                                </div>
                            </div>
                        </div>
                    <% } else if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
                        <div class="d-flex align-items-center">
                            <a href="/membermanagement.aspx" class="badge badge-danger p-2 mr-2 text-white text-decoration-none shadow-sm"><i class="fas fa-user-shield mr-1"></i> অ্যাডমিনিস্ট্রেটর</a>
                            <a class="btn btn-outline-danger btn-sm font-weight-bold btn-logout-action shadow-sm" href="/logout"><i class="fas fa-sign-out-alt mr-1"></i> লগআউট</a>
                        </div>
                    <% } else { %>
                        <a class="btn btn-outline-primary btn-sm px-3 font-weight-bold shadow-sm" href="/login.aspx" id="navLoginBtn">
                            <i class="fas fa-sign-in-alt mr-1"></i> লগইন
                        </a>
                    <% } %>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <script>
    (function() {
        function syncAuthNavbar() {
            var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io') || window.location.pathname.endsWith('.html');
            var isAdmin = (sessionStorage.getItem('chapainawabganj_admin_logged_in') === 'true' || localStorage.getItem('chapainawabganj_admin_logged_in') === 'true');
            var studentUser = null;
            try {
                var raw = sessionStorage.getItem('chapainawabganj_current_user') || localStorage.getItem('chapainawabganj_current_user');
                if (raw) studentUser = JSON.parse(raw);
                if (!studentUser) {
                    var loginId = sessionStorage.getItem('chapainawabganj_user_logged_in') || localStorage.getItem('chapainawabganj_user_logged_in');
                    if (loginId) {
                        var localRaw = localStorage.getItem('chapainawabganj_local_members');
                        var list = localRaw ? JSON.parse(localRaw) : [];
                        for (var i = 0; i < list.length; i++) {
                            if (String(list[i].student_id) === String(loginId) || String(list[i].email) === String(loginId) || String(list[i].contact_number) === String(loginId)) {
                                studentUser = list[i];
                                break;
                            }
                        }
                        if (!studentUser) {
                            studentUser = { full_name: 'শিক্ষার্থী', student_id: loginId, status: 'Active' };
                        }
                    }
                }
            } catch(e) {}

            var mainNavList = document.getElementById('mainNavList');
            var userAreaContainer = document.getElementById('userAreaContainer');

            if (isAdmin) {
                // Ensure Admin Dropdown is present in main navigation menu
                if (!document.getElementById('adminNavDropdown') && mainNavList) {
                    var adminLi = document.createElement('li');
                    adminLi.className = 'nav-item dropdown ml-lg-2';
                    adminLi.id = 'adminNavDropdown';
                    var linkPrefix = isStatic ? '' : '/';
                    var ext = isStatic ? '.html' : '.aspx';
                    adminLi.innerHTML = 
                        '<a class="nav-link dropdown-toggle text-danger font-weight-bold" href="#" id="adminMenuDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">' +
                            '<i class="fas fa-shield-alt mr-1"></i> অ্যাডমিন প্যানেল' +
                        '</a>' +
                        '<div class="dropdown-menu shadow border-0" aria-labelledby="adminMenuDropdown">' +
                            '<a class="dropdown-item" href="' + linkPrefix + 'membermanagement' + ext + '"><i class="fas fa-user-check text-success mr-2"></i> শিক্ষার্থী ভেরিফিকেশন ও তালিকা</a>' +
                            '<a class="dropdown-item" href="' + linkPrefix + 'admin_update_member' + ext + '"><i class="fas fa-user-edit text-primary mr-2"></i> তথ্য সংশোধন ও আপডেট</a>' +
                            '<a class="dropdown-item" href="' + linkPrefix + 'admin_content' + ext + '"><i class="fas fa-bullhorn text-info mr-2"></i> নোটিশ ও ফাইল আপলোড</a>' +
                            '<div class="dropdown-divider"></div>' +
                            '<a class="dropdown-item text-danger btn-logout-action" href="#" style="cursor:pointer;"><i class="fas fa-sign-out-alt mr-2"></i> অ্যাডমিন লগআউট</a>' +
                        '</div>';
                    mainNavList.appendChild(adminLi);
                }

                // Ensure Admin Badge & Logout Button are in user area
                if (userAreaContainer) {
                    var linkPrefix = isStatic ? '' : '/';
                    var ext = isStatic ? '.html' : '.aspx';
                    userAreaContainer.innerHTML = 
                        '<div class="d-flex align-items-center">' +
                            '<a href="' + linkPrefix + 'membermanagement' + ext + '" class="badge badge-danger p-2 mr-2 text-white text-decoration-none shadow-sm"><i class="fas fa-user-shield mr-1"></i> অ্যাডমিনিস্ট্রেটর</a>' +
                            '<button type="button" class="btn btn-outline-danger btn-sm font-weight-bold btn-logout-action shadow-sm"><i class="fas fa-sign-out-alt mr-1"></i> লগআউট</button>' +
                        '</div>';
                }
            } else if (studentUser) {
                var adminDrop = document.getElementById('adminNavDropdown');
                if (adminDrop) adminDrop.remove();

                if (userAreaContainer) {
                    var firstName = (studentUser.full_name || 'শিক্ষার্থী').split(' ')[0];
                    var statusClass = studentUser.status === 'Active' ? 'success' : 'warning';
                    var statusText = studentUser.status === 'Active' ? 'সক্রিয়' : 'পেন্ডিং';
                    var photo = studentUser.profile_photo || 'Photo/fahim.png';
                    var linkPrefix = isStatic ? '' : '/';
                    var ext = isStatic ? '.html' : '.aspx';

                    userAreaContainer.innerHTML = 
                        '<div class="d-flex align-items-center">' +
                            '<img src="' + photo + '" class="rounded-circle mr-2 border border-success" alt="Profile" height="38" width="38" style="object-fit:cover;" onerror="this.onerror=null; this.src=\'Photo/fahim.png\';" />' +
                            '<div class="dropdown">' +
                                '<a class="nav-link dropdown-toggle font-weight-bold text-dark px-1" href="#" id="userDropdown" role="button" data-toggle="dropdown">' +
                                    firstName +
                                    '<span class="badge badge-' + statusClass + ' ml-1">' + statusText + '</span>' +
                                '</a>' +
                                '<div class="dropdown-menu dropdown-menu-right shadow border-0">' +
                                    '<a class="dropdown-item" href="' + linkPrefix + 'my_profile' + ext + '"><i class="fas fa-id-card text-primary mr-2"></i> প্রোফাইল ও ডিজিটাল আইডি</a>' +
                                    '<div class="dropdown-divider"></div>' +
                                    '<a class="dropdown-item text-danger btn-logout-action" href="#" style="cursor:pointer;"><i class="fas fa-sign-out-alt mr-2"></i> লগআউট</a>' +
                                '</div>' +
                            '</div>' +
                        '</div>';
                }
            } else {
                var adminDrop = document.getElementById('adminNavDropdown');
                var path = window.location.pathname.toLowerCase();
                var isAdminPage = path.includes('membermanagement') || path.includes('admin_update_member') || path.includes('admin_content');

                if (isStatic && !isAdminPage && adminDrop) {
                    adminDrop.remove();
                }

                if (isStatic && isAdminPage && !isAdmin) {
                    alert('অ্যাডমিন প্যানেলে প্রবেশ করতে প্রথমে সঠিক ইউজারনেম ও পাসওয়ার্ড দিয়ে লগইন করুন।');
                    window.location.href = 'adminlogin.html';
                }
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', syncAuthNavbar);
        } else {
            syncAuthNavbar();
        }

        // Global Logout Handler
        document.addEventListener('click', function(e) {
            var target = e.target.closest('.btn-logout-action');
            if (!target && e.target.tagName === 'A') {
                var href = e.target.getAttribute('href') || '';
                if (href === '/logout' || href.endsWith('logout') || href.endsWith('logout.html')) {
                    target = e.target;
                }
            }
            if (target) {
                e.preventDefault();
                sessionStorage.removeItem('chapainawabganj_admin_logged_in');
                localStorage.removeItem('chapainawabganj_admin_logged_in');
                sessionStorage.removeItem('chapainawabganj_current_user');
                localStorage.removeItem('chapainawabganj_current_user');
                sessionStorage.removeItem('chapainawabganj_user_logged_in');
                localStorage.removeItem('chapainawabganj_user_logged_in');
                alert('সফলভাবে লগআউট সম্পন্ন হয়েছে।');
                var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io') || window.location.pathname.endsWith('.html');
                window.location.href = isStatic ? 'index.html' : '/';
            }
        });
    })();
    </script>

    <!-- Global Flash Alerts -->
    <div class="container mt-3">
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="fas fa-check-circle mr-2"></i> <%= success_msg %>
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="fas fa-exclamation-triangle mr-2"></i> <%= error_msg %>
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        <% } %>
    </div>
