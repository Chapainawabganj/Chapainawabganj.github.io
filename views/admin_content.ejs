<%- include('partials/header', { title: 'নোটিশ ও ডকুমেন্টস ব্যবস্থাপনা (Admin Content)', activePage: 'admin_content' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="card shadow border-0">
            <div class="card-body p-4 p-md-5">

                <div class="page-title-banner">
                    <i class="fas fa-bullhorn mr-2"></i> অ্যাডমিন: নোটিশ ও ডকুমেন্টস ব্যবস্থাপনা
                </div>

                <div class="row">
                    <!-- Manage Notices Section -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border h-100 shadow-sm">
                            <div class="card-header bg-danger text-white font-weight-bold">
                                <i class="fas fa-bullhorn mr-2"></i> নোটিশ প্রকাশ ও ব্যবস্থাপনা (Notices)
                            </div>
                            <div class="card-body">
                                <h6 class="font-weight-bold text-dark border-bottom pb-2">নতুন নোটিশ প্রকাশ করুন</h6>
                                <form action="/admin/add_notice" method="POST" enctype="multipart/form-data" class="mb-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">নোটিশের শিরোনাম</label>
                                        <input type="text" name="title" class="form-control" placeholder="যেমন: বার্ষিক সাধারণ সভা ও নবীনবরণ নোটিশ" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">সংযুক্তি ফাইল (PDF / ছবি)</label>
                                        <input type="file" name="notice_file" class="form-control-file" required />
                                    </div>
                                    <button type="submit" class="btn btn-danger btn-sm font-weight-bold">
                                        <i class="fas fa-upload mr-1"></i> নোটিশ প্রকাশ করুন
                                    </button>
                                </form>

                                <h6 class="font-weight-bold text-dark border-bottom pb-2">প্রকাশিত নোটিশসমূহ</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>শিরোনাম</th>
                                                <th>তারিখ</th>
                                                <th style="width: 80px;" class="text-center">মুছুন</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% notices.forEach(function(n) { %>
                                                <tr>
                                                    <td><a href="/<%= n.file_url %>" target="_blank"><%= n.title %></a></td>
                                                    <td><small class="text-muted"><%= n.date %></small></td>
                                                    <td class="text-center">
                                                        <form action="/admin/delete_notice" method="POST" onsubmit="return confirm('এই নোটিশটি মুছে ফেলতে চান?');">
                                                            <input type="hidden" name="id" value="<%= n.id %>" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2"><i class="fas fa-trash"></i></button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Manage Downloads Section -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border h-100 shadow-sm">
                            <div class="card-header bg-navy text-white font-weight-bold" style="background-color: var(--navy-blue);">
                                <i class="fas fa-download mr-2"></i> ডাউনলোড ফাইল ব্যবস্থাপনা (Downloads)
                            </div>
                            <div class="card-body">
                                <h6 class="font-weight-bold text-dark border-bottom pb-2">নতুন ফরম বা ফাইল আপলোড করুন</h6>
                                <form action="/admin/add_download" method="POST" enctype="multipart/form-data" class="mb-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">ডকুমেন্টের শিরোনাম</label>
                                        <input type="text" name="title" class="form-control" placeholder="যেমন: জেলা সমিতি গঠনতন্ত্র ও সদস্য নির্দেশিকা" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">ফাইল (PDF, DOCX, ছবি)</label>
                                        <input type="file" name="download_file" class="form-control-file" required />
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold">
                                        <i class="fas fa-upload mr-1"></i> ফাইল আপলোড করুন
                                    </button>
                                </form>

                                <h6 class="font-weight-bold text-dark border-bottom pb-2">বিদ্যমান ডাউনলোডসমূহ</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>শিরোনাম</th>
                                                <th>তারিখ</th>
                                                <th style="width: 80px;" class="text-center">মুছুন</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% downloads.forEach(function(d) { %>
                                                <tr>
                                                    <td><a href="/<%= d.file_url %>" target="_blank"><%= d.title %></a></td>
                                                    <td><small class="text-muted"><%= d.date %></small></td>
                                                    <td class="text-center">
                                                        <form action="/admin/delete_download" method="POST" onsubmit="return confirm('এই ফাইলটি মুছে ফেলতে চান?');">
                                                            <input type="hidden" name="id" value="<%= d.id %>" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2"><i class="fas fa-trash"></i></button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="card-footer bg-white border-0 pb-4 pl-4">
                <a href="/membermanagement.aspx" class="text-primary font-weight-bold">&lt;&lt; সদস্য ব্যবস্থাপনায় ফিরে যান</a>
            </div>
        </div>
    </div>
</section>

<script>
$(document).ready(function() {
    var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io') || window.location.pathname.endsWith('.html');
    if (isStatic) {
        $('form[action*="add_notice"]').on('submit', function(e) {
            e.preventDefault();
            var title = ($('input[name="title"]').val() || '').trim();
            alert('নোটিশ "' + title + '" সফলভাবে তৈরি ও সংরক্ষণ করা হয়েছে!');
            location.reload();
        });

        $('form[action*="delete_notice"]').on('submit', function(e) {
            e.preventDefault();
            $(this).closest('tr').remove();
            alert('নোটিশটি সফলভাবে মুছে ফেলা হয়েছে!');
        });

        $('form[action*="add_download"]').on('submit', function(e) {
            e.preventDefault();
            var title = ($('form[action*="add_download"] input[name="title"]').val() || '').trim();
            alert('ডাউনলোড ফাইল "' + title + '" সফলভাবে সংরক্ষিত হয়েছে!');
            location.reload();
        });

        $('form[action*="delete_download"]').on('submit', function(e) {
            e.preventDefault();
            $(this).closest('tr').remove();
            alert('ফাইলটি সফলভাবে মুছে ফেলা হয়েছে!');
        });
    }
});
</script>

<%- include('partials/footer') %>
