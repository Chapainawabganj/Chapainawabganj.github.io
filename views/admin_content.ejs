<%- include('partials/header', { title: 'নোটিশ ও ডকুমেন্টস ব্যবস্থাপনা (Admin Content)', activePage: 'admin_content' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="card shadow border-0">
            <div class="card-body p-4 p-md-5">

                <div class="page-title-banner">
                    <i class="fas fa-bullhorn mr-2"></i> অ্যাডমিন: নোটিশ ও ডকুমেন্টস ব্যবস্থাপনা
                </div>

                <div class="row">
                    <!-- Manage Notices Section -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border h-100 shadow-sm">
                            <div class="card-header bg-danger text-white font-weight-bold">
                                <i class="fas fa-bullhorn mr-2"></i> নোটিশ প্রকাশ ও ব্যবস্থাপনা (Notices)
                            </div>
                            <div class="card-body">
                                <h6 class="font-weight-bold text-dark border-bottom pb-2">নতুন নোটিশ প্রকাশ করুন</h6>
                                <form id="addNoticeForm" class="mb-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">নোটিশের শিরোনাম</label>
                                        <input type="text" name="notice_title" id="noticeTitle" class="form-control" placeholder="যেমন: বার্ষিক সাধারণ সভা ও নবীনবরণ নোটিশ" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">নোটিশ ফাইল লিঙ্ক (URL/Google Drive)</label>
                                        <input type="url" name="notice_url" id="noticeUrl" class="form-control" placeholder="https://drive.google.com/file/... অথবা যেকোনো লিঙ্ক" />
                                        <small class="text-muted">Google Drive লিঙ্ক, PDF URL, বা যেকোনো ডাউনলোডযোগ্য লিঙ্ক দিন</small>
                                    </div>
                                    <button type="submit" class="btn btn-danger btn-sm font-weight-bold">
                                        <i class="fas fa-upload mr-1"></i> নোটিশ প্রকাশ করুন
                                    </button>
                                </form>

                                <h6 class="font-weight-bold text-dark border-bottom pb-2">প্রকাশিত নোটিশসমূহ</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>শিরোনাম</th>
                                                <th>তারিখ</th>
                                                <th style="width: 80px;" class="text-center">মুছুন</th>
                                            </tr>
                                        </thead>
                                        <tbody id="storedNoticesBody">
                                            <tr><td colspan="3" class="text-center text-muted">লোড হচ্ছে...</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Manage Downloads Section -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border h-100 shadow-sm">
                            <div class="card-header font-weight-bold text-white" style="background-color: var(--navy-blue);">
                                <i class="fas fa-download mr-2"></i> ডাউনলোড ফাইল ব্যবস্থাপনা (Downloads)
                            </div>
                            <div class="card-body">
                                <h6 class="font-weight-bold text-dark border-bottom pb-2">নতুন ফরম বা ফাইল আপলোড করুন</h6>
                                <form id="addDownloadForm" class="mb-4">
                                    <div class="form-group">
                                        <label class="font-weight-bold">ডকুমেন্টের শিরোনাম</label>
                                        <input type="text" name="download_title" id="downloadTitle" class="form-control" placeholder="যেমন: জেলা সমিতি গঠনতন্ত্র ও সদস্য নির্দেশিকা" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">ফাইল লিঙ্ক (URL/Google Drive)</label>
                                        <input type="url" name="download_url" id="downloadUrl" class="form-control" placeholder="https://drive.google.com/file/... অথবা যেকোনো লিঙ্ক" />
                                        <small class="text-muted">Google Drive, PDF URL বা যেকোনো ডাউনলোডযোগ্য লিঙ্ক দিন</small>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm font-weight-bold">
                                        <i class="fas fa-upload mr-1"></i> ফাইল সংরক্ষণ করুন
                                    </button>
                                </form>

                                <h6 class="font-weight-bold text-dark border-bottom pb-2">বিদ্যমান ডাউনলোডসমূহ</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>শিরোনাম</th>
                                                <th>তারিখ</th>
                                                <th style="width: 80px;" class="text-center">মুছুন</th>
                                            </tr>
                                        </thead>
                                        <tbody id="storedDownloadsBody">
                                            <tr><td colspan="3" class="text-center text-muted">লোড হচ্ছে...</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="card-footer bg-white border-0 pb-4 pl-4">
                <a href="membermanagement.html" class="text-primary font-weight-bold">&lt;&lt; সদস্য ব্যবস্থাপনায় ফিরে যান</a>
            </div>
        </div>
    </div>
</section>

<script>
$(document).ready(function() {

    // ---- Helper: get current date in Bengali ----
    function getToday() {
        return new Date().toLocaleDateString('bn-BD', {year:'numeric', month:'long', day:'numeric'});
    }

    // ---- Render stored notices ----
    function renderNotices() {
        var list = [];
        try { var r = localStorage.getItem('chapainawabganj_notices'); if(r) list = JSON.parse(r); } catch(e){}
        var tbody = $('#storedNoticesBody');
        tbody.empty();
        if (!list.length) {
            tbody.append('<tr><td colspan="3" class="text-center text-muted py-3">কোনো নোটিশ প্রকাশিত হয়নি।</td></tr>');
            return;
        }
        list.forEach(function(n, idx) {
            var titleHtml = $('<span>').text(n.title).html();
            var link = n.file_url ? '<a href="'+n.file_url+'" target="_blank" class="text-primary font-weight-bold">'+titleHtml+'</a>' : '<span>'+titleHtml+'</span>';
            tbody.append('<tr><td>'+link+'</td><td><small class="text-muted">'+n.date+'</small></td>'
                +'<td class="text-center"><button class="btn btn-outline-danger btn-sm py-0 px-2 btn-del-notice" data-idx="'+idx+'"><i class="fas fa-trash"></i></button></td></tr>');
        });
    }

    // ---- Render stored downloads ----
    function renderDownloads() {
        var list = [];
        try { var r = localStorage.getItem('chapainawabganj_downloads'); if(r) list = JSON.parse(r); } catch(e){}
        var tbody = $('#storedDownloadsBody');
        tbody.empty();
        if (!list.length) {
            tbody.append('<tr><td colspan="3" class="text-center text-muted py-3">কোনো ডাউনলোড ফাইল নেই।</td></tr>');
            return;
        }
        list.forEach(function(d, idx) {
            var titleHtml = $('<span>').text(d.title).html();
            var link = d.file_url ? '<a href="'+d.file_url+'" target="_blank" class="text-primary font-weight-bold">'+titleHtml+'</a>' : '<span>'+titleHtml+'</span>';
            tbody.append('<tr><td>'+link+'</td><td><small class="text-muted">'+d.date+'</small></td>'
                +'<td class="text-center"><button class="btn btn-outline-danger btn-sm py-0 px-2 btn-del-download" data-idx="'+idx+'"><i class="fas fa-trash"></i></button></td></tr>');
        });
    }

    renderNotices();
    renderDownloads();

    // ---- Add Notice ----
    $('#addNoticeForm').on('submit', function(e) {
        e.preventDefault();
        var title = ($('#noticeTitle').val() || '').trim();
        var file_url = ($('#noticeUrl').val() || '').trim();
        if (!title) { alert('নোটিশের শিরোনাম দিন!'); return; }
        var list = [];
        try { var r = localStorage.getItem('chapainawabganj_notices'); if(r) list = JSON.parse(r); } catch(e){}
        list.unshift({ id: 'n_' + Date.now(), title: title, date: getToday(), file_url: file_url });
        localStorage.setItem('chapainawabganj_notices', JSON.stringify(list));
        if(window.addActivityLog) window.addActivityLog('নতুন নোটিশ প্রকাশ: ' + title, 'admin');
        $('#noticeTitle').val('');
        $('#noticeUrl').val('');
        renderNotices();
        alert('নোটিশ "' + title + '" সফলভাবে প্রকাশ করা হয়েছে! এখন notice.html পেজে দেখা যাবে।');
    });

    // ---- Add Download ----
    $('#addDownloadForm').on('submit', function(e) {
        e.preventDefault();
        var title = ($('#downloadTitle').val() || '').trim();
        var file_url = ($('#downloadUrl').val() || '').trim();
        if (!title) { alert('ডকুমেন্টের শিরোনাম দিন!'); return; }
        var list = [];
        try { var r = localStorage.getItem('chapainawabganj_downloads'); if(r) list = JSON.parse(r); } catch(e){}
        list.unshift({ id: 'd_' + Date.now(), title: title, date: getToday(), file_url: file_url });
        localStorage.setItem('chapainawabganj_downloads', JSON.stringify(list));
        if(window.addActivityLog) window.addActivityLog('নতুন ডাউনলোড ফাইল যোগ: ' + title, 'admin');
        $('#downloadTitle').val('');
        $('#downloadUrl').val('');
        renderDownloads();
        alert('ফাইল "' + title + '" সফলভাবে সংরক্ষিত হয়েছে! এখন download.html পেজে দেখা যাবে।');
    });

    // ---- Delete Notice ----
    $(document).on('click', '.btn-del-notice', function() {
        var idx = parseInt($(this).data('idx'));
        if (!confirm('এই নোটিশটি মুছে ফেলতে চান?')) return;
        var list = [];
        try { var r = localStorage.getItem('chapainawabganj_notices'); if(r) list = JSON.parse(r); } catch(e){}
        list.splice(idx, 1);
        localStorage.setItem('chapainawabganj_notices', JSON.stringify(list));
        if(window.addActivityLog) window.addActivityLog('নোটিশ মুছে ফেলা হয়েছে।', 'admin');
        renderNotices();
        alert('নোটিশটি সফলভাবে মুছে ফেলা হয়েছে!');
    });

    // ---- Delete Download ----
    $(document).on('click', '.btn-del-download', function() {
        var idx = parseInt($(this).data('idx'));
        if (!confirm('এই ফাইলটি মুছে ফেলতে চান?')) return;
        var list = [];
        try { var r = localStorage.getItem('chapainawabganj_downloads'); if(r) list = JSON.parse(r); } catch(e){}
        list.splice(idx, 1);
        localStorage.setItem('chapainawabganj_downloads', JSON.stringify(list));
        if(window.addActivityLog) window.addActivityLog('ডাউনলোড ফাইল মুছে ফেলা হয়েছে।', 'admin');
        renderDownloads();
        alert('ফাইলটি সফলভাবে মুছে ফেলা হয়েছে!');
    });
});
</script>

<%- include('partials/footer') %>
