<%- include('partials/header', { title: 'শিক্ষার্থী ও সদস্য লগইন (Member Login)', activePage: 'login' }) %>

<section class="content my-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow border-0 rounded-lg" style="overflow: hidden;">
                    
                    <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, var(--navy-blue) 0%, var(--emerald-green) 100%);">
                        <img src="/Photo/fahim.png" alt="Student Avatar" class="rounded-circle border p-1 shadow-sm mb-2" style="width: 75px; height: 75px; object-fit: cover;" />
                        <h4 class="font-weight-bold mb-0">শিক্ষার্থী ও সদস্য লগইন</h4>
                        <small class="text-light">পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি</small>
                    </div>

                    <div class="card-body p-4 p-md-5">

                        <form action="/login.aspx" method="POST">
                            <div class="form-group mb-3">
                                <label class="font-weight-bold text-dark">ইমেইল অথবা স্টুডেন্ট আইডি</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-id-card text-success"></i></span>
                                    </div>
                                    <input type="text" name="email" class="form-control" placeholder="যেমন: 200101 বা emran.cse@s.pust.ac.bd" required />
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                <label class="font-weight-bold text-dark">পাসওয়ার্ড</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-lock text-success"></i></span>
                                    </div>
                                    <input type="password" name="password" class="form-control" placeholder="আপনার অ্যাকাউন্টের পাসওয়ার্ড" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-emerald btn-block btn-lg font-weight-bold shadow-sm mb-3">
                                <i class="fas fa-sign-in-alt mr-2"></i> লগইন করুন
                            </button>

                            <div class="text-center my-3 text-muted">
                                <span>- নতুন শিক্ষার্থী? -</span>
                            </div>

                            <a href="/registration.aspx" class="btn btn-navy btn-block btn-lg font-weight-bold shadow-sm">
                                <i class="fas fa-user-plus mr-2"></i> সদস্য হিসেবে নিবন্ধন করুন
                            </a>
                        </form>

                        <div class="text-center text-muted small mt-4">
                            <i class="fas fa-lock text-success mr-1"></i> আপনার তথ্য সম্পূর্ণ সুরক্ষিত
                        </div>

                    </div>
                    <div class="card-footer bg-white border-0 text-center pb-4">
                        <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; হোমে ফিরে যান</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
$('form').on('submit', function(e) {
    var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io') || window.location.pathname.endsWith('.html');
    if (isStatic) {
        e.preventDefault();
        var id = ($('input[name="email"]').val() || '').trim();
        var enteredPass = ($('input[name="password"]').val() || '').trim();

        var localRaw = localStorage.getItem('chapainawabganj_local_members');
        var list = localRaw ? JSON.parse(localRaw) : [];
        var found = null;
        for (var i = 0; i < list.length; i++) {
            var m = list[i];
            if (String(m.student_id) === id || String(m.roll_no) === id ||
                String(m.email).toLowerCase() === id.toLowerCase() ||
                String(m.contact_number) === id) {
                found = m;
                break;
            }
        }

        if (!found) {
            alert('কোনো অ্যাকাউন্ট পাওয়া যায়নি! অনুগ্রহ করে সঠিক স্টুডেন্ট আইডি, ইমেইল বা মোবাইল নম্বর দিন।');
            return;
        }

        // Password check: if student has stored password, verify it; otherwise allow login
        if (found.password && found.password.length > 0 && found.password !== enteredPass) {
            alert('পাসওয়ার্ড সঠিক নয়! অনুগ্রহ করে আপনার সঠিক পাসওয়ার্ড দিন।');
            return;
        }

        sessionStorage.setItem('chapainawabganj_user_logged_in', id);
        localStorage.setItem('chapainawabganj_user_logged_in', id);
        sessionStorage.setItem('chapainawabganj_current_user', JSON.stringify(found));
        localStorage.setItem('chapainawabganj_current_user', JSON.stringify(found));
        window.location.href = 'my_profile.html';
    }
});
</script>

<%- include('partials/footer') %>
