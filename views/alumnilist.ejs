<%- include('partials/header', { title: 'Alumni List', activePage: 'alumnilist' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="page-title-banner">
                            PUST EEE ALUMNI DIRECTORY
                        </div>

                        <!-- Top Quick Search Form -->
                        <form action="/alumnilist.aspx" method="GET" class="my-4">
                            <div class="row justify-content-center">
                                <div class="col-md-8">
                                    <div class="input-group input-group-lg shadow-sm">
                                        <input type="text" name="q" value="<%= typeof query !== 'undefined' ? query : '' %>" class="form-control" placeholder="Search Member by Name, Roll, Batch, or Company..." />
                                        <div class="input-group-append">
                                            <button class="btn btn-primary font-weight-bold px-4" type="submit">
                                                <i class="fas fa-search"></i> SEARCH
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <!-- Alumni Members Table -->
                        <div class="table-responsive mt-4">
                            <table class="table table-striped table-bordered datatable" style="width: 100%;">
                                <thead>
                                    <tr style="background-color: #006699; color: white;">
                                        <th class="text-center align-middle" style="width: 70px;">Photo</th>
                                        <th class="align-middle">Full Name</th>
                                        <th class="text-center align-middle">Roll Number</th>
                                        <th class="text-center align-middle">Batch</th>
                                        <th class="text-center align-middle">Blood Group</th>
                                        <th class="align-middle">Employment Organization</th>
                                        <th class="text-center align-middle" style="width: 100px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (members && members.length > 0) { %>
                                        <% members.forEach(function(member, index) { %>
                                            <tr>
                                                <td class="text-center align-middle">
                                                    <img src="/<%= member.profile_photo || 'Photo/fahim.png' %>" alt="<%= member.full_name %>" class="rounded-circle border" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                                                </td>
                                                <td class="align-middle font-weight-bold text-primary">
                                                    <%= member.full_name %>
                                                    <% if (member.membership_type === 'Fellow') { %>
                                                        <span class="badge badge-info ml-1">Fellow</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center align-middle font-weight-bold">
                                                    <%= member.roll_no %>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span class="badge badge-light border px-2 py-1"><%= member.batch_no || '1st' %></span>
                                                </td>
                                                <td class="text-center align-middle font-weight-bold text-danger">
                                                    <%= member.blood_group || 'N/A' %>
                                                </td>
                                                <td class="align-middle">
                                                    <strong><%= member.organization || 'Not Specified' %></strong>
                                                    <% if (member.designation) { %>
                                                        <br><small class="text-muted"><%= member.designation %></small>
                                                    <% } %>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-outline-primary btn-sm" data-toggle="modal" data-target="#memberModal_<%= index %>">
                                                        <i class="fas fa-eye"></i> View
                                                    </button>
                                                </td>
                                            </tr>

                                            <!-- Modal Profile Preview -->
                                            <div class="modal fade" id="memberModal_<%= index %>" tabindex="-1" role="dialog" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered" role="document">
                                                    <div class="modal-content border-0 shadow">
                                                        <div class="modal-header bg-primary text-white">
                                                            <h5 class="modal-title font-weight-bold"><%= member.full_name %></h5>
                                                            <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                        </div>
                                                        <div class="modal-body text-center p-4">
                                                            <img src="/<%= member.profile_photo || 'Photo/fahim.png' %>" alt="<%= member.full_name %>" class="rounded-circle border p-1 shadow-sm mb-3" style="width: 100px; height: 100px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                                                            <h4 class="font-weight-bold mb-1"><%= member.full_name %></h4>
                                                            <p class="text-muted mb-2"><%= member.degree %> | Batch: <%= member.batch_no %></p>
                                                            <span class="badge badge-success px-3 py-1 mb-3">Roll: <%= member.roll_no %></span>

                                                            <div class="text-left bg-light p-3 rounded mt-2" style="font-size: 14px;">
                                                                <p class="mb-1"><strong><i class="fas fa-tint text-danger mr-2"></i> Blood Group:</strong> <%= member.blood_group || 'N/A' %></p>
                                                                <p class="mb-1"><strong><i class="fas fa-building text-info mr-2"></i> Organization:</strong> <%= member.organization || 'N/A' %></p>
                                                                <p class="mb-1"><strong><i class="fas fa-id-badge text-secondary mr-2"></i> Designation:</strong> <%= member.designation || 'N/A' %></p>
                                                                <p class="mb-1"><strong><i class="fas fa-envelope text-primary mr-2"></i> Email:</strong> <%= member.email || 'N/A' %></p>
                                                                <p class="mb-0"><strong><i class="fas fa-phone text-success mr-2"></i> Contact:</strong> <%= member.contact_number || 'N/A' %></p>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                No members found matching your search.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <div class="card-footer bg-white border-0 pb-4 pl-4">
                        <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; Back to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
