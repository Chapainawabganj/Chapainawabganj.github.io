<%- include('partials/header', { title: 'শিক্ষার্থী ও সদস্য তালিকা (Student Directory)', activePage: 'alumnilist' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="page-title-banner">
                            <i class="fas fa-users mr-2"></i> পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি - শিক্ষার্থী ও সদস্য তালিকা
                        </div>

                        <!-- Top Search & Upazila Filter Pills -->
                        <div class="mb-4">
                            <form action="/alumnilist.aspx" method="GET" class="mb-3">
                                <div class="row justify-content-center">
                                    <div class="col-md-8">
                                        <div class="input-group input-group-lg shadow-sm">
                                            <input type="text" name="q" value="<%= typeof query !== 'undefined' ? query : '' %>" class="form-control" placeholder="নাম, স্টুডেন্ট আইডি, বিভাগ, সেশন বা পেশা লিখে খুঁজুন..." />
                                            <div class="input-group-append">
                                                <button class="btn btn-emerald font-weight-bold px-4" type="submit">
                                                    <i class="fas fa-search mr-1"></i> অনুসন্ধান
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>

                            <!-- Upazila Filter Buttons -->
                            <div class="text-center mt-3">
                                <span class="font-weight-bold text-dark mr-2">উপজেলা ফিল্টার:</span>
                                <% const upazilas = [
                                    { label: 'সকল উপজেলা', val: 'All' },
                                    { label: 'চাঁপাইনবাবগঞ্জ সদর', val: 'Chapainawabganj Sadar' },
                                    { label: 'শিবগঞ্জ', val: 'Shibganj' },
                                    { label: 'গোমস্তাপুর', val: 'Gomostapur' },
                                    { label: 'নাচোল', val: 'Nachole' },
                                    { label: 'ভোলাহাট', val: 'Bholahat' }
                                ]; %>
                                <% upazilas.forEach(function(u) { %>
                                    <a href="/alumnilist.aspx<%= u.val === 'All' ? '' : '?upazila=' + encodeURIComponent(u.val) %>" 
                                       class="upazila-pill <%= (typeof selectedUpazila !== 'undefined' && selectedUpazila === u.val) || (u.val === 'All' && (!selectedUpazila || selectedUpazila === 'All')) ? 'active' : '' %>">
                                        <%= u.label %>
                                    </a>
                                <% }); %>
                            </div>
                        </div>

                        <!-- Members Table -->
                        <div class="table-responsive mt-3">
                            <table class="table table-hover table-bordered datatable" style="width: 100%;">
                                <thead style="background-color: var(--navy-blue); color: white;">
                                    <tr>
                                        <th class="text-center align-middle" style="width: 70px;">ছবি</th>
                                        <th class="align-middle">শিক্ষার্থীর নাম ও বর্তমান অবস্থান</th>
                                        <th class="text-center align-middle" style="width: 110px;">স্টুডেন্ট আইডি</th>
                                        <th class="align-middle">বিভাগ</th>
                                        <th class="text-center align-middle" style="width: 90px;">সেশন</th>
                                        <th class="text-center align-middle" style="width: 130px;">উপজেলা</th>
                                        <th class="text-center align-middle" style="width: 80px;">রক্ত</th>
                                        <th class="text-center align-middle" style="width: 90px;">বিবরণ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (members && members.length > 0) { %>
                                        <% members.forEach(function(m, idx) { %>
                                            <tr>
                                                <td class="text-center align-middle">
                                                    <img src="/<%= m.profile_photo || 'Photo/fahim.png' %>" alt="<%= m.full_name %>" class="rounded-circle border" style="width: 48px; height: 48px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                                                </td>
                                                <td class="align-middle">
                                                    <strong class="text-dark" style="font-size: 16px;"><%= m.full_name %></strong>
                                                    <br><small class="text-muted"><%= m.profession %></small>
                                                </td>
                                                <td class="text-center align-middle font-weight-bold text-primary">
                                                    <%= m.student_id || m.roll_no %>
                                                </td>
                                                <td class="align-middle">
                                                    <strong><%= m.department %></strong>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span class="badge badge-session"><%= m.session %></span>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span class="badge badge-upazila"><%= m.upazila %></span>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span class="badge badge-blood"><%= m.blood_group || 'N/A' %></span>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-outline-emerald btn-sm font-weight-bold" data-toggle="modal" data-target="#studentModal_<%= idx %>">
                                                        <i class="fas fa-eye"></i> বিস্তারিত
                                                    </button>
                                                </td>
                                            </tr>

                                            <!-- Modal Profile Preview -->
                                            <div class="modal fade" id="studentModal_<%= idx %>" tabindex="-1" role="dialog" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered" role="document">
                                                    <div class="modal-content border-0 shadow">
                                                        <div class="modal-header text-white" style="background: linear-gradient(135deg, var(--navy-blue) 0%, var(--emerald-green) 100%);">
                                                            <h5 class="modal-title font-weight-bold">
                                                                <i class="fas fa-user-graduate mr-2"></i> <%= m.full_name %>
                                                            </h5>
                                                            <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                                                        </div>
                                                        <div class="modal-body p-4 text-center">
                                                            <img src="/<%= m.profile_photo || 'Photo/fahim.png' %>" alt="<%= m.full_name %>" class="rounded-circle border border-success p-1 shadow-sm mb-3" style="width: 105px; height: 105px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                                                            <h4 class="font-weight-bold text-dark mb-1"><%= m.full_name %></h4>
                                                            <p class="text-muted mb-2"><%= m.profession %></p>
                                                            <p class="mb-3">
                                                                <span class="badge badge-upazila px-3 py-1 font-weight-bold"><i class="fas fa-map-marker-alt mr-1"></i> <%= m.upazila %>, চাঁপাইনবাবগঞ্জ</span>
                                                                <span class="badge badge-session px-3 py-1 font-weight-bold"><%= m.session %> সেশন</span>
                                                            </p>

                                                            <div class="text-left bg-light p-3 rounded" style="font-size: 14px; line-height: 1.8;">
                                                                <p class="mb-1"><strong><i class="fas fa-id-badge text-primary mr-2"></i> স্টুডেন্ট আইডি:</strong> <%= m.student_id || m.roll_no %></p>
                                                                <p class="mb-1"><strong><i class="fas fa-graduation-cap text-success mr-2"></i> বিভাগ:</strong> <%= m.department %></p>
                                                                <p class="mb-1"><strong><i class="fas fa-tint text-danger mr-2"></i> রক্তের গ্রুপ:</strong> <%= m.blood_group || 'N/A' %></p>
                                                                <p class="mb-1"><strong><i class="fas fa-hotel text-warning mr-2"></i> হল / মেস:</strong> <%= m.hall || 'N/A' %></p>
                                                                <p class="mb-1"><strong><i class="fas fa-map-pin text-info mr-2"></i> বর্তমান ঠিকানা:</strong> <%= m.present_address %></p>
                                                                <p class="mb-0"><strong><i class="fas fa-envelope text-secondary mr-2"></i> ইমেইল:</strong> <%= m.email %></p>
                                                            </div>

                                                            <div class="mt-4 d-flex justify-content-center">
                                                                <a href="tel:<%= m.contact_number %>" class="btn btn-success font-weight-bold mr-2 px-3">
                                                                    <i class="fas fa-phone-alt mr-1"></i> কল করুন
                                                                </a>
                                                                <a href="https://wa.me/<%= m.contact_number.replace(/[^0-9]/g, '') %>" target="_blank" class="btn btn-outline-success font-weight-bold px-3">
                                                                    <i class="fab fa-whatsapp mr-1"></i> হোয়াটসঅ্যাপ
                                                                </a>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light py-2">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">বন্ধ করুন</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="8" class="text-center py-4 text-muted">
                                                কোনো শিক্ষার্থী বা সদস্যের তথ্য পাওয়া যায়নি।
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <div class="card-footer bg-white border-0 pb-4 pl-4">
                        <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; হোমে ফিরে যান</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
