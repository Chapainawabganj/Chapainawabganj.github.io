<script>
$(document).ready(function() {
    var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io') || window.location.pathname.endsWith('.html');
    if (isStatic) {
        try {
            var raw = localStorage.getItem('chapainawabganj_site_settings');
            if (raw) {
                var s = JSON.parse(raw);
                if (s.general) {
                    if (s.general.contact_phone) {
                        $('#contactHotline').attr('href', 'tel:' + s.general.contact_phone).text(s.general.contact_phone);
                    }
                    if (s.general.contact_email) {
                        $('#contactEmail').attr('href', 'mailto:' + s.general.contact_email).text(s.general.contact_email);
                    }
                    if (s.general.office_address) {
                        $('#contactAddress').text(s.general.office_address);
                    }
                }
            }
        } catch(e) {}
    }
});
</script>

