<%- include('partials/header', { title: 'শিক্ষার্থী সহায়তা সেল (Student Support)', activePage: 'support' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="page-title-banner">
                            <i class="fas fa-hands-helping mr-2"></i> পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি - শিক্ষার্থী সহায়তা ও কল্যাণ সেল
                        </div>

                        <!-- Intro Banner -->
                        <div class="text-center mb-5">
