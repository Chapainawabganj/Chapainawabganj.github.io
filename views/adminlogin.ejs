<%- include('partials/header', { title: 'অ্যাডমিন লগইন (Admin Login)', activePage: 'adminlogin' }) %>

<section class="content my-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow border-0 rounded-lg" style="overflow: hidden;">

                    <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, var(--navy-blue) 0%, #0f172a 100%);">
                        <img src="/Photo/adminuser.png" alt="Admin" class="rounded-circle border p-1 shadow-sm mb-2" style="width: 75px; height: 75px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                        <h4 class="font-weight-bold mb-0">কেন্দ্রীয় অ্যাডমিন পোর্টাল</h4>
                        <small class="text-light">পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি</small>
                    </div>

                    <div class="card-body p-4 p-md-5">

                        <form action="/adminlogin.aspx" method="POST">
                            <div class="form-group mb-3">
                                <label class="font-weight-bold text-dark">অ্যাডমিনিস্ট্রেটর ইউজারনেম</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-user-shield text-danger"></i></span>
                                    </div>
                                    <input type="text" name="username" class="form-control" placeholder="অ্যাডমিন ইউজারনেম লিখুন" required />
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                <label class="font-weight-bold text-dark">অ্যাডমিন পাসওয়ার্ড</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-key text-danger"></i></span>
                                    </div>
                                    <input type="password" name="password" class="form-control" placeholder="গোপন পাসওয়ার্ড লিখুন" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-danger btn-block btn-lg font-weight-bold shadow-sm mb-3">
                                <i class="fas fa-lock-open mr-2"></i> অ্যাডমিন ড্যাশবোর্ডে প্রবেশ করুন
                            </button>
                        </form>

                        <div class="text-center text-muted small mt-4">
                            <i class="fas fa-shield-alt text-success mr-1"></i> সুরক্ষিত কেন্দ্রীয় অ্যাডমিনিস্ট্রেশন সিস্টেম
                        </div>

                    </div>
                    <div class="card-footer bg-white border-0 text-center pb-4">
                        <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; হোমে ফিরে যান</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
