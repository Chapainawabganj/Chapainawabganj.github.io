<%- include('partials/header', { title: 'শিক্ষার্থী ভেরিফিকেশন ও ব্যবস্থাপনা (Admin Panel)', activePage: 'membermanagement' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-4">
        <div class="card shadow border-0">
            <div class="card-body p-4">

                <!-- Admin Navigation Banner -->
                <div class="row mb-3">
                    <div class="col-md-6 mb-2">
                        <div class="page-title-banner p-2 m-0">
                            <a href="/admin_update_member.aspx" class="text-white text-decoration-none">
                                <center><i class="fas fa-user-edit mr-2"></i> স্টুডেন্ট প্রোফাইল এডিট ও আপডেট</center>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <div class="page-title-banner p-2 m-0" style="background: linear-gradient(135deg, var(--emerald-green) 0%, #0d9488 100%);">
                            <a href="/admin_content.aspx" class="text-white text-decoration-none">
                                <center><i class="fas fa-bullhorn mr-2"></i> নোটিশ ও বিজ্ঞপ্তি আপলোড</center>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Stats Counters -->
                <div class="row my-4">
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card p-3 text-center rounded border-0 text-white shadow-sm" style="background-color: var(--navy-blue);">
                            <h3 class="font-weight-bold m-0"><%= members.length %></h3>
                            <small>মোট নিবন্ধিত শিক্ষার্থী</small>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card bg-success text-white p-3 text-center rounded border-0 shadow-sm">
                            <h3 class="font-weight-bold m-0"><%= members.filter(m => m.status === 'Active').length %></h3>
                            <small>সক্রিয় ও অনুমোদিত (Active)</small>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card bg-warning text-dark p-3 text-center rounded border-0 shadow-sm">
                            <h3 class="font-weight-bold m-0"><%= members.filter(m => m.status === 'Pending').length %></h3>
                            <small>ভেরিফিকেশন অপেক্ষমান (Pending)</small>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card bg-danger text-white p-3 text-center rounded border-0 shadow-sm">
                            <h3 class="font-weight-bold m-0"><%= members.filter(m => m.is_blood_donor).length %></h3>
                            <small>জরুরি রক্তদাতা (Blood Donors)</small>
                        </div>
                    </div>
                </div>

                <!-- Students & Members Verification Table -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom pb-2 mb-3">
                    <div>
                        <h4 class="font-weight-bold text-dark m-0">
                            <i class="fas fa-user-check text-success mr-2"></i> শিক্ষার্থী নিবন্ধন ও ভেরিফিকেশন তালিকা
                        </h4>
                        <span class="text-muted small">
                            পেন্ডিং শিক্ষার্থীদের নামের পাশে <span class="badge badge-success"><i class="fas fa-check"></i></span> বাটনে ক্লিক করে তাৎক্ষণিক অনুমোদন দিন
                        </span>
                    </div>
                    <div class="mt-2 mt-md-0 d-flex flex-wrap">
                        <a href="/admin/export_csv" id="btnExportCSV" class="btn btn-success btn-sm font-weight-bold shadow-sm mr-2 mb-1">
                            <i class="fas fa-file-excel mr-1"></i> এক্সেল / CSV ডাউনলোড
                        </a>
                        <a href="/admin/export_json" id="btnExportJSON" class="btn btn-navy btn-sm font-weight-bold shadow-sm mr-2 mb-1">
                            <i class="fas fa-file-code mr-1"></i> JSON ব্যাকআপ ডাউনলোড
                        </a>
                        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm font-weight-bold shadow-sm mb-1">
                            <i class="fas fa-print mr-1"></i> প্রিন্ট তালিকা
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-bordered datatable" style="width: 100%;">
                        <thead style="background-color: var(--navy-blue); color: white;">
                            <tr>
                                <th class="text-center align-middle" style="width: 60px;">ছবি</th>
                                <th class="align-middle">শিক্ষার্থীর নাম ও যোগাযোগ</th>
                                <th class="text-center align-middle" style="width: 110px;">আইডি / রোল</th>
                                <th class="align-middle">বিভাগ ও সেশন</th>
                                <th class="text-center align-middle" style="width: 120px;">উপজেলা</th>
                                <th class="text-center align-middle" style="width: 80px;">রক্ত</th>
                                <th class="text-center align-middle" style="width: 120px;">ভেরিফিকেশন স্ট্যাটাস</th>
                                <th class="text-center align-middle" style="width: 140px;">অ্যাডমিন অ্যাকশন</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% members.forEach(function(member) { %>
                                <tr class="<%= member.status === 'Pending' ? 'table-warning' : '' %>">
                                    <td class="text-center align-middle">
                                        <img src="/<%= member.profile_photo || 'Photo/fahim.png' %>" alt="<%= member.full_name %>" class="rounded-circle border" style="width: 44px; height: 44px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                                    </td>
                                    <td class="align-middle">
                                        <strong class="text-dark"><%= member.full_name %></strong>
                                        <br><small class="text-muted"><i class="fas fa-phone mr-1 text-success"></i> <%= member.contact_number %></small>
                                        <br><small class="text-muted"><i class="fas fa-envelope mr-1 text-primary"></i> <%= member.email %></small>
                                    </td>
                                    <td class="text-center align-middle font-weight-bold text-primary">
                                        <%= member.student_id || member.roll_no %>
                                    </td>
                                    <td class="align-middle">
                                        <strong><%= member.department %></strong>
                                        <br><span class="badge badge-session"><%= member.session %> সেশন</span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="badge badge-upazila"><%= member.upazila %></span>
                                        <br><small class="text-muted"><%= member.profession %></small>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="badge badge-blood"><%= member.blood_group || 'N/A' %></span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <% if (member.status === 'Active') { %>
                                            <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> সক্রিয় (Active)</span>
                                        <% } else { %>
                                            <span class="badge badge-warning px-2 py-1"><i class="fas fa-clock mr-1"></i> ভেরিফিকেশন পেন্ডিং</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center align-middle">
                                        <div class="btn-group btn-group-sm">
                                            <!-- Toggle Status / Approve -->
                                            <form action="/admin/toggle_status" method="POST" style="display:inline;">
                                                <input type="hidden" name="id" value="<%= member.id %>" />
                                                <% if (member.status === 'Active') { %>
                                                    <button type="submit" class="btn btn-warning" title="পেন্ডিং করুন (Make Pending)">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                <% } else { %>
                                                    <button type="submit" class="btn btn-success font-weight-bold px-2" title="ভেরিফাই ও অনুমোদন দিন (Verify & Approve)">
                                                        <i class="fas fa-check"></i> অনুমোদন
                                                    </button>
                                                <% } %>
                                            </form>
                                            
                                            <!-- Edit Member Profile -->
                                            <a href="/admin_update_member.aspx?roll=<%= member.student_id || member.roll_no %>" class="btn btn-primary" title="সম্পূর্ণ তথ্য এডিট করুন">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <!-- Delete Member -->
                                            <form action="/admin/delete_member" method="POST" style="display:inline;" onsubmit="return confirm('আপনি কি নিশ্চিত যে শিক্ষার্থী <%= member.full_name %> এর তথ্য ডিলিট করতে চান?');">
                                                <input type="hidden" name="id" value="<%= member.id %>" />
                                                <button type="submit" class="btn btn-danger" title="ডিলিট করুন">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

            </div>
            <div class="card-footer bg-white border-0 pb-4 pl-4">
                <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; হোমে ফিরে যান</a>
            </div>
        </div>
    </div>
</section>

<script>
    var serverMembers = <%- JSON.stringify(members) %>;

    function getAllCurrentMembers() {
        var local = [];
        try {
            var raw = localStorage.getItem('chapainawabganj_local_members');
            if (raw) local = JSON.parse(raw);
        } catch(e) {}
        var map = {};
        serverMembers.forEach(function(m) {
            var key = m.student_id || m.roll_no || m.id;
            map[key] = m;
        });
        local.forEach(function(m) {
            var key = m.student_id || m.roll_no || m.id;
            map[key] = m;
        });
        var list = [];
        for (var k in map) {
            if (map.hasOwnProperty(k)) list.push(map[k]);
        }
        return list;
    }

    function exportToCSV(members) {
        var headers = [
            "আইডি (ID)",
            "মেম্বারশিপ কোড (Membership Code)",
            "শিক্ষার্থীর পূর্ণ নাম (Full Name)",
            "লিঙ্গ (Gender)",
            "বিভাগ (Department)",
            "সেশন (Academic Session)",
            "স্টুডেন্ট আইডি / রোল (Student ID)",
            "মোবাইল নম্বর (Contact Mobile)",
            "ইমেইল ঠিকানা (Email)",
            "নিজ উপজেলা (Home Upazila)",
            "রক্তের গ্রুপ (Blood Group)",
            "জরুরি রক্তদাতা (Blood Donor)",
            "বর্তমান পেশা (Current Profession)",
            "হল / মেস (Residential Hall/Mess)",
            "বর্তমান পূর্ণ ঠিকানা (Present Address)",
            "ভেরিফিকেশন স্ট্যাটাস (Verification Status)",
            "নিবন্ধনের তারিখ (Registration Date)"
        ];

        var csv = "\uFEFF"; // UTF-8 BOM for Excel
        csv += headers.map(function(h) { return '"' + h.replace(/"/g, '""') + '"'; }).join(",") + "\r\n";

        members.forEach(function(m) {
            var row = [
                m.id || "",
                m.membership_id || ("CP-PUST-" + (m.student_id || m.roll_no || "")),
                m.full_name || "",
                m.gender || "Male",
                m.department || "",
                m.session || "",
                m.student_id || m.roll_no || "",
                m.contact_number || "",
                m.email || "",
                m.upazila || "",
                m.blood_group || "",
                m.is_blood_donor ? "হ্যাঁ (Yes)" : "না (No)",
                m.profession || "",
                m.hall || "",
                m.present_address || "",
                m.status || "Pending",
                m.created_at || ""
            ];
            csv += row.map(function(val) { return '"' + String(val).replace(/"/g, '""') + '"'; }).join(",") + "\r\n";
        });

        var blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
        var url = URL.createObjectURL(blob);
        var link = document.createElement("a");
        var dateStr = new Date().toISOString().split("T")[0];
        link.setAttribute("href", url);
        link.setAttribute("download", "chapainawabganj_pust_students_" + dateStr + ".csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function exportToJSON(members) {
        var str = JSON.stringify(members, null, 2);
        var blob = new Blob([str], { type: "application/json;charset=utf-8;" });
        var url = URL.createObjectURL(blob);
        var link = document.createElement("a");
        var dateStr = new Date().toISOString().split("T")[0];
        link.setAttribute("href", url);
        link.setAttribute("download", "chapainawabganj_pust_members_backup_" + dateStr + ".json");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    $(document).ready(function() {
        var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io');

        $('#btnExportCSV').on('click', function(e) {
            if (isStatic) {
                e.preventDefault();
                exportToCSV(getAllCurrentMembers());
            }
        });

        $('#btnExportJSON').on('click', function(e) {
            if (isStatic) {
                e.preventDefault();
                exportToJSON(getAllCurrentMembers());
            }
        });

        if (isStatic) {
            try {
                var raw = localStorage.getItem('chapainawabganj_local_members');
                if (raw) {
                    var local = JSON.parse(raw);
                    var datatable = $('.datatable').DataTable();
                    local.forEach(function(m) {
                        var exists = false;
                        serverMembers.forEach(function(sm) {
                            if (sm.id === m.id || sm.student_id === m.student_id) exists = true;
                        });
                        if (!exists) {
                            var photo = m.profile_photo || 'Photo/fahim.png';
                            var statusBadge = m.status === 'Active' 
                                ? '<span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> সক্রিয় (Active)</span>'
                                : '<span class="badge badge-warning px-2 py-1"><i class="fas fa-clock mr-1"></i> ভেরিফিকেশন পেন্ডিং</span>';

                            var toggleBtn = '<button class="btn btn-sm btn-success font-weight-bold btn-toggle-local" data-id="' + m.id + '" title="অনুমোদন করুন"><i class="fas fa-check"></i></button>';

                            datatable.row.add([
                                '<div class="text-center"><img src="' + photo + '" class="rounded-circle border" style="width: 44px; height: 44px; object-fit: cover;" onerror="this.src=\'Photo/fahim.png\'" /></div>',
                                '<strong>' + m.full_name + '</strong><br><small class="text-muted"><i class="fas fa-phone mr-1 text-success"></i> ' + m.contact_number + '</small><br><small class="text-muted"><i class="fas fa-envelope mr-1 text-primary"></i> ' + m.email + '</small>',
                                '<span class="font-weight-bold text-primary">' + (m.student_id || m.roll_no) + '</span>',
                                '<strong>' + m.department + '</strong><br><span class="badge badge-session">' + m.session + ' সেশন</span>',
                                '<span class="badge badge-upazila">' + m.upazila + '</span><br><small class="text-muted">' + m.profession + '</small>',
                                '<span class="badge badge-blood">' + (m.blood_group || 'N/A') + '</span>',
                                statusBadge,
                                '<div class="btn-group btn-group-sm">' + toggleBtn + '</div>'
                            ]).draw(false);
                        }
                    });
                }
            } catch(e) {
                console.warn('Error loading local registrations:', e);
            }

            $(document).on('click', '.btn-toggle-local', function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var raw = localStorage.getItem('chapainawabganj_local_members');
                if (raw) {
                    var list = JSON.parse(raw);
                    list.forEach(function(item) {
                        if (item.id === id) {
                            item.status = item.status === 'Active' ? 'Pending' : 'Active';
                        }
                    });
                    localStorage.setItem('chapainawabganj_local_members', JSON.stringify(list));
                    alert('স্ট্যাটাস পরিবর্তন সফল হয়েছে!');
                    location.reload();
                }
            });
        }
    });
</script>

<%- include('partials/footer') %>
