<%- include('partials/header', { title: 'নিবন্ধন নিশ্চিতকরণ (Registration Confirmation)', activePage: 'registration' }) %>

<section class="content my-4">
    <div class="container px-lg-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="confirmation-card p-4 p-md-5">

                    <!-- Success Circle -->
                    <div class="confirmation-check-circle">
                        <i class="fas fa-check"></i>
                    </div>

                    <div class="text-center mb-4">
                        <h3 class="font-weight-bold text-dark mb-2">নিবন্ধন সফলভাবে সম্পন্ন হয়েছে!</h3>
                        <h5 style="color: var(--emerald-green); font-weight: 600;">
                            পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়স্থ চাঁপাইনবাবগঞ্জ জেলা সমিতি
                        </h5>
                        <div class="mt-3">
                            <span class="badge badge-warning p-2 px-3 shadow-sm font-weight-bold" style="font-size: 14px;">
                                <i class="fas fa-clock mr-1"></i> স্ট্যাটাস: পেন্ডিং অ্যাডমিন ভেরিফিকেশন (Pending Admin Verification)
                            </span>
                        </div>
                    </div>

                    <!-- Notice Card -->
                    <div class="alert alert-light border p-3 rounded mb-4" style="background-color: #f8fafc;">
                        <h6 class="font-weight-bold text-primary mb-1">
                            <i class="fas fa-user-shield mr-1"></i> পরবর্তী ধাপ (Next Steps):
                        </h6>
                        <p class="mb-0 text-muted" style="font-size: 14px; line-height: 1.7;">
                            আপনার রেজিস্ট্রেশন তথ্য কেন্দ্রীয় অ্যাডমিন প্যানেলে প্রেরণ করা হয়েছে। জেলা সমিতির দায়িত্বপ্রাপ্ত অ্যাডমিন আপনার প্রাতিষ্ঠানিক তথ্য যাচাই করার পর অ্যাকাউন্টটি সম্পূর্ণ সক্রিয় করা হবে। সক্রিয় হওয়ার পর আপনি লগইন করে আপনার <strong>ডিজিটাল স্টুডেন্ট মেম্বারশিপ কার্ড</strong> ডাউনলোড ও প্রিন্ট করতে পারবেন।
                        </p>
                    </div>

                    <!-- Student Registration Summary -->
                    <h5 class="font-weight-bold border-bottom pb-2 mb-3 text-dark">
                        <i class="fas fa-id-card text-success mr-2"></i> নিবন্ধিত তথ্যের সারসংক্ষেপ (Application Summary)
                    </h5>

                    <div class="card p-3 bg-light border mb-4">
                        <div class="row align-items-center mb-3 pb-3 border-bottom">
                            <div class="col-md-3 text-center mb-2 mb-md-0">
                                <img id="confPhoto" src="/<%= student.profile_photo || 'Photo/fahim.png' %>" alt="<%= student.full_name %>" class="rounded-circle border border-success p-1 shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                            </div>
                            <div class="col-md-9">
                                <h4 class="font-weight-bold text-dark mb-1" id="confFullName"><%= student.full_name %></h4>
                                <p class="text-muted mb-1">
                                    <span class="badge badge-session mr-1" id="confSession"><%= student.session %> সেশন</span>
                                    <span class="badge badge-upazila" id="confUpazila"><i class="fas fa-map-marker-alt mr-1"></i> <%= student.upazila %>, চাঁপাইনবাবগঞ্জ</span>
                                </p>
                                <span class="badge badge-primary px-3 py-1 font-weight-bold" id="confStudentId">
                                    স্টুডেন্ট আইডি: <%= student.student_id || student.roll_no %>
                                </span>
                            </div>
                        </div>

                        <div class="row" style="font-size: 15px;">
                            <div class="col-md-6 mb-2">
                                <strong><i class="fas fa-graduation-cap text-primary mr-2"></i> বিভাগ (Department):</strong>
                                <span class="text-dark" id="confDepartment"><%= student.department %></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="fas fa-tint text-danger mr-2"></i> রক্তের গ্রুপ (Blood Group):</strong>
                                <span class="badge badge-blood" id="confBloodGroup"><%= student.blood_group || 'N/A' %></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="fas fa-phone-alt text-success mr-2"></i> মোবাইল নম্বর (Mobile):</strong>
                                <span class="text-dark font-weight-bold" id="confMobile"><%= student.contact_number %></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="fas fa-envelope text-info mr-2"></i> ইমেইল (Email):</strong>
                                <span class="text-dark" id="confEmail"><%= student.email %></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="fas fa-briefcase text-secondary mr-2"></i> বর্তমান পেশা (Profession):</strong>
                                <span class="text-dark" id="confProfession"><%= student.profession %></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="fas fa-hotel text-warning mr-2"></i> হল / মেস (Residential):</strong>
                                <span class="text-dark" id="confHall"><%= student.hall || 'N/A' %></span>
                            </div>
                            <div class="col-12 mb-0">
                                <strong><i class="fas fa-home text-muted mr-2"></i> বর্তমান ঠিকানা (Present Address):</strong>
                                <span class="text-dark" id="confAddress"><%= student.present_address %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center d-flex flex-column flex-sm-row justify-content-center">
                        <button onclick="window.print();" class="btn btn-outline-secondary font-weight-bold px-4 py-2 m-1">
                            <i class="fas fa-print mr-2"></i> প্রিন্ট বা সেভ করুন (Print Slip)
                        </button>
                        <a href="/login.aspx" class="btn btn-navy font-weight-bold px-4 py-2 m-1">
                            <i class="fas fa-sign-in-alt mr-2"></i> অ্যাকাউন্টে লগইন করুন
                        </a>
                        <a href="/home.aspx" class="btn btn-emerald font-weight-bold px-4 py-2 m-1">
                            <i class="fas fa-home mr-2"></i> হোমে ফিরে যান
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<script>
$(document).ready(function() {
    var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io');
    if (isStatic) {
        var raw = localStorage.getItem('chapainawabganj_current_registration');
        if (raw) {
            try {
                var s = JSON.parse(raw);
                if (s.full_name) $('#confFullName').text(s.full_name);
                if (s.profile_photo) $('#confPhoto').attr('src', s.profile_photo);
                if (s.session) $('#confSession').text(s.session + ' সেশন');
                if (s.upazila) $('#confUpazila').html('<i class="fas fa-map-marker-alt mr-1"></i> ' + s.upazila + ', চাঁপাইনবাবগঞ্জ');
                if (s.student_id) $('#confStudentId').text('স্টুডেন্ট আইডি: ' + s.student_id);
                if (s.department) $('#confDepartment').text(s.department);
                if (s.blood_group) $('#confBloodGroup').text(s.blood_group);
                if (s.contact_number) $('#confMobile').text(s.contact_number);
                if (s.email) $('#confEmail').text(s.email);
                if (s.profession) $('#confProfession').text(s.profession);
                if (s.hall) $('#confHall').text(s.hall);
                if (s.present_address) $('#confAddress').text(s.present_address);
            } catch(e) {
                console.warn('Error reading confirmation from localStorage:', e);
            }
        }
    }
});
</script>

<%- include('partials/footer') %>
