<%- include('partials/header', { title: 'হোম (Home)', activePage: 'home' }) %>

    <!-- Home Page Hero Banner (Clean, Modern, No EEE Background) -->
    <section class="text-center my-4">
        <div class="container">
            <div class="shadow-sm rounded overflow-hidden position-relative" style="background: linear-gradient(135deg, var(--navy-blue) 0%, #16406d 50%, var(--emerald-green) 100%); min-height: 360px; display: flex; align-items: center; justify-content: center;">
                
                <!-- Background Campus Image with Deep Gradient Overlay -->
                <div class="position-absolute w-100 h-100" style="top: 0; left: 0; background: url('/Photo/pust%20lake.jpg') center/cover no-repeat; opacity: 0.28;"></div>
                
                <!-- Hero Content -->
                <div class="position-relative text-white p-4 p-md-5 w-100" style="z-index: 2;">
                    <div class="mb-3">
                        <span class="badge badge-light px-3 py-2 font-weight-bold text-dark shadow-sm" style="font-size: 13px; letter-spacing: 0.5px;">
                            <i class="fas fa-university text-primary mr-1"></i> পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয় (PUST)
                        </span>
                    </div>

                    <h1 class="font-weight-bold display-4 mb-2" style="font-size: clamp(1.8rem, 4.5vw, 2.9rem); text-shadow: 0 2px 8px rgba(0,0,0,0.5);">
                        পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি
                    </h1>
                    
                    <h5 class="font-weight-normal mb-4 text-light" style="font-size: clamp(1rem, 2.5vw, 1.35rem); text-shadow: 0 1px 4px rgba(0,0,0,0.4); max-width: 800px; margin-left: auto; margin-right: auto;">
                        ঐক্য, ভ্রাতৃত্ব ও প্রগতির সেতুবন্ধন &bull; চাঁপাইনবাবগঞ্জের সকল শিক্ষার্থী ও গ্র্যাজুয়েটদের অভিন্ন প্ল্যাটফর্ম
                    </h5>
                    
                    <div class="d-flex flex-wrap justify-content-center">
                        <a href="/registration.aspx" class="btn btn-emerald btn-lg font-weight-bold shadow px-4 m-2" style="font-size: 17px; border-radius: 8px;">
                            <i class="fas fa-user-plus mr-2"></i> সদস্য নিবন্ধন করুন
                        </a>
                        <a href="/alumnilist.aspx" class="btn btn-outline-light btn-lg font-weight-bold shadow px-4 m-2" style="font-size: 17px; border-radius: 8px;">
                            <i class="fas fa-search mr-2"></i> শিক্ষার্থী ডিরেক্টরি
                        </a>
                        <a href="/blood_donation.aspx" class="btn btn-danger btn-lg font-weight-bold shadow px-4 m-2" style="font-size: 17px; border-radius: 8px;">
                            <i class="fas fa-tint mr-2"></i> জরুরি রক্তদাতা
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Welcome Section -->
    <section class="container text-center my-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h3 class="font-weight-bold text-dark mb-3">
                    স্বাগতম! পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়স্থ চাঁপাইনবাবগঞ্জ জেলা সমিতিতে
                </h3>
                <p class="lead text-muted" style="line-height: 1.8; font-size: 1.15rem;">
                    পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়ে (পাবিপ্রবি) অধ্যয়নরত আম্রকানন ও রেশমের দেশ চাঁপাইনবাবগঞ্জের সকল শিক্ষার্থী এবং প্রাক্তন গ্র্যাজুয়েটদের অভিন্ন প্ল্যাটফর্মে আন্তরিক স্বাগতম। 
                    আমাদের এই সমিতি পাবনা ক্যাম্পাসে চাঁপাইনবাবগঞ্জের শিক্ষার্থীদের পারস্পরিক ঐক্য, মেস ও আবাসন সংকট সমাধান, ভর্তিচ্ছুদের দিকনির্দেশনা, জরুরি রক্তদান এবং ক্যারিয়ার গঠনে একটি সক্রিয় পরিবার হিসেবে নিরলস কাজ করে যাচ্ছে।
                </p>
            </div>
        </div>
    </section>

    <!-- Student Support Features Section -->
    <section class="container my-5 py-2">
        <div class="text-center mb-5">
            <h3 class="font-weight-bold text-dark">শিক্ষার্থী সহায়তায় আমাদের প্রধান সেবাসমূহ</h3>
            <p class="text-muted font-weight-bold">চাঁপাইনবাবগঞ্জের শিক্ষার্থীদের জন্য সার্বক্ষণিক সাপোর্ট</p>
            <div style="width: 70px; height: 3px; background-color: var(--emerald-green); margin: 10px auto;"></div>
        </div>

        <div class="row">
            <!-- 1. Admission Support -->
            <div class="col-sm-12 col-md-6 col-lg-3 mb-4">
                <div class="card feature-box h-100 p-4 text-center border shadow-sm">
                    <div class="feature-icon-circle">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <h5 class="font-weight-bold text-dark">ভর্তি সহায়তা সেল</h5>
                    <p class="text-muted small mt-2">
                        নতুন ভর্তিচ্ছু শিক্ষার্থীদের বাস টার্মিনাল রিসিভ, তথ্য সহায়তা ও পরীক্ষার দিনে ক্যাম্পাসে সিট খুঁজে দেওয়া।
                    </p>
                    <a href="/student_support.aspx" class="btn btn-outline-emerald btn-sm mt-auto font-weight-bold">বিস্তারিত দেখুন</a>
                </div>
            </div>

            <!-- 2. Mess & Accommodation -->
            <div class="col-sm-12 col-md-6 col-lg-3 mb-4">
                <div class="card feature-box h-100 p-4 text-center border shadow-sm">
                    <div class="feature-icon-circle">
                        <i class="fas fa-home"></i>
                    </div>
                    <h5 class="font-weight-bold text-dark">মেস ও আবাসন</h5>
                    <p class="text-muted small mt-2">
                        পাবনা শহরে ক্যাম্পাসের কাছাকাছি নিরাপদ ছাত্র ও ছাত্রী মেস নির্বাচনে দিকনির্দেশনা ও সার্বিক সহযোগিতা।
                    </p>
                    <a href="/student_support.aspx#mess" class="btn btn-outline-emerald btn-sm mt-auto font-weight-bold">আবাসন গাইড</a>
                </div>
            </div>

            <!-- 3. Blood Network -->
            <div class="col-sm-12 col-md-6 col-lg-3 mb-4">
                <div class="card feature-box h-100 p-4 text-center border shadow-sm">
                    <div class="feature-icon-circle" style="background-color: #fee2e2; color: #dc2626;">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <h5 class="font-weight-bold text-dark">জরুরি রক্তদান</h5>
                    <p class="text-muted small mt-2">
                        পাবনা সদর হাসপাতাল ও চাঁপাইনবাবগঞ্জে জরুরি রোগীর প্রয়োজনে তাৎক্ষণিক রক্তদাতা সন্ধান ও যোগাযোগ।
                    </p>
                    <a href="/blood_donation.aspx" class="btn btn-outline-danger btn-sm mt-auto font-weight-bold">রক্তদাতা খুঁজুন</a>
                </div>
            </div>

            <!-- 4. Career Mentorship -->
            <div class="col-sm-12 col-md-6 col-lg-3 mb-4">
                <div class="card feature-box h-100 p-4 text-center border shadow-sm">
                    <div class="feature-icon-circle" style="background-color: #eff6ff; color: #2563eb;">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <h5 class="font-weight-bold text-dark">ক্যারিয়ার ও মেন্টরিং</h5>
                    <p class="text-muted small mt-2">
                        বিসিএস, ব্যাংক ও আইটি সেক্টরে কর্মরত পাবিপ্রবির চাঁপাইনবাবগঞ্জের সিনিয়রদের নিয়মিত পরামর্শ।
                    </p>
                    <a href="/student_support.aspx" class="btn btn-outline-primary btn-sm mt-auto font-weight-bold">মেন্টরশিপ তথ্য</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Upazilas Representation Section -->
    <section class="py-5" style="background-color: #edf5f0;">
        <div class="container text-center">
            <h3 class="font-weight-bold text-dark mb-2">চাঁপাইনবাবগঞ্জ জেলার ৫টি উপজেলার মিলনমেলা</h3>
            <p class="text-muted mb-4">পাবিপ্রবিতে চাঁপাইনবাবগঞ্জের প্রতিটি উপজেলার শিক্ষার্থীরা একই পরিবারের সদস্য</p>

            <div class="row justify-content-center">
                <div class="col-6 col-md-2 mb-3">
                    <div class="p-3 bg-white rounded shadow-sm border">
                        <i class="fas fa-city fa-2x text-primary mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-0">সদর উপজেলা</h6>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <div class="p-3 bg-white rounded shadow-sm border">
                        <i class="fas fa-monument fa-2x text-success mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-0">শিবগঞ্জ</h6>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <div class="p-3 bg-white rounded shadow-sm border">
                        <i class="fas fa-landmark fa-2x text-info mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-0">গোমস্তাপুর</h6>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <div class="p-3 bg-white rounded shadow-sm border">
                        <i class="fas fa-train fa-2x text-warning mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-0">নাচোল</h6>
                    </div>
                </div>
                <div class="col-6 col-md-2 mb-3">
                    <div class="p-3 bg-white rounded shadow-sm border">
                        <i class="fas fa-tree fa-2x text-emerald mb-2"></i>
                        <h6 class="font-weight-bold text-dark mb-0">ভোলাহাট</h6>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section class="container my-5 py-3">
        <div class="text-center mb-5">
            <h3 class="font-weight-bold text-dark">সদস্যভুক্তি ও আইডি কার্ড প্রাপ্তির সহজ ৩ ধাপ</h3>
            <p class="text-muted font-weight-bold">সহজ ও দ্রুত প্রক্রিয়ায় জেলা সমিতির সক্রিয় সদস্য হোন</p>
            <div style="width: 70px; height: 3px; background-color: var(--navy-blue); margin: 10px auto;"></div>
        </div>

        <div class="row text-center">
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <div class="overflow-hidden rounded mb-3" style="height: 180px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/library.jpg" alt="Registration" style="object-fit: cover;" />
                    </div>
                    <h5 class="font-weight-bold text-dark mt-2">১. অনলাইন ফরম পূরণ</h5>
                    <p class="text-muted small mt-2">আপনার নাম, ছবি, স্টুডেন্ট আইডি, বিভাগ, সেশন ও উপজেলার তথ্য দিয়ে ফরম পূরণ করুন।</p>
                    <a href="/registration.aspx" class="btn btn-outline-emerald btn-sm mt-auto font-weight-bold">নিবন্ধন ফরম</a>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <div class="overflow-hidden rounded mb-3" style="height: 180px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/Untitled987.jpg" alt="Admin Verification" style="object-fit: cover;" />
                    </div>
                    <h5 class="font-weight-bold text-dark mt-2">২. অ্যাডমিন ভেরিফিকেশন</h5>
                    <p class="text-muted small mt-2">জেলা সমিতির কেন্দ্রীয় কমিটি আপনার স্টুডেন্ট তথ্য যাচাই করে সক্রিয় অনুমোদন দেবে।</p>
                    <span class="badge badge-warning p-2 px-3 mt-auto font-weight-bold">Admin Verification</span>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <div class="overflow-hidden rounded mb-3" style="height: 180px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/Untitled.jpg" alt="Digital Card" style="object-fit: cover;" />
                    </div>
                    <h5 class="font-weight-bold text-dark mt-2">৩. ডিজিটাল স্টুডেন্ট আইডি কার্ড</h5>
                    <p class="text-muted small mt-2">অনুমোদন পাওয়ার পর লগইন করে আপনার আকর্ষণীয় ডিজিটাল আইডি কার্ড ডাউনলোড করুন।</p>
                    <a href="/login.aspx" class="btn btn-outline-primary btn-sm mt-auto font-weight-bold">লগইন প্যানেল</a>
                </div>
            </div>
        </div>
    </section>

<%- include('partials/footer') %>
