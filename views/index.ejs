<%- include('partials/header', { title: 'Home', activePage: 'home' }) %>

    <!-- Home Page Image Banner -->
    <section class="text-center my-4">
        <div class="container">
            <div class="shadow-sm rounded overflow-hidden">
                <img class="img-fluid w-100" src="/Photo/Home%20Page.jpg" alt="Home Page Image" style="max-height: 420px; object-fit: cover;" onerror="this.src='/Photo/pust lake.jpg'" />
            </div>
        </div>
    </section>

    <!-- Welcome Section -->
    <section class="container text-center my-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h2 class="font-weight-bold text-dark mb-4">Welcome to the EEE Alumni of PUST</h2>
                <p class="lead text-muted" style="line-height: 1.8; font-size: 1.15rem;">
                    Welcome to the PUST EEE Alumni website! If you're a graduate of PUST EEE who hasn't joined our community yet, 
                    we sincerely invite you to become a member. Joining is simple and affordable, and it grants you the opportunity to 
                    be a part of the vibrant PUST EEE Alumni community and engage in various forms of fellowship. 
                    <br/><br/>
                    Make the most of this organization's offerings and contribute to the growth and success of our beloved alma mater, PUST. 
                    Let's unite in giving it the love, attention, and support it truly deserves, as we strive for greater achievements 
                    and a world-class reputation. Embrace the pride of being a PUST EEE graduate and together, let's celebrate our accomplishments!
                </p>
                <div class="mt-4">
                    <a href="/registration.aspx" class="btn btn-primary btn-lg px-4 mr-2 shadow-sm font-weight-bold">
                        <i class="fas fa-user-plus mr-1"></i> Apply for Membership
                    </a>
                    <a href="/alumnilist.aspx" class="btn btn-outline-secondary btn-lg px-4 shadow-sm font-weight-bold">
                        <i class="fas fa-search mr-1"></i> Search Alumni
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="container my-5 py-3">
        <div class="text-center mb-5">
            <h2 class="font-weight-bold text-dark">Our Features</h2>
            <p class="text-muted font-weight-bold" style="font-size: 1.1rem;">Our 3 Primary Features -</p>
            <div style="width: 60px; height: 3px; background-color: #007bff; margin: 10px auto;"></div>
        </div>

        <div class="row text-center">
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="overflow-hidden rounded mb-3" style="height: 220px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/pust%20lake.jpg" alt="PUST Lake Image" style="object-fit: cover;" />
                    </div>
                    <h4 class="font-weight-bold text-dark mt-2">Foster Networking and Connections</h4>
                    <p class="text-muted mt-2">Connect with fellow graduates across various industries, creating lasting professional and personal relationships.</p>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="overflow-hidden rounded mb-3" style="height: 220px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/pust%20building1.jpg" alt="PUST Building Image" style="object-fit: cover;" />
                    </div>
                    <h4 class="font-weight-bold text-dark mt-2">Support Professional Development</h4>
                    <p class="text-muted mt-2">Access valuable mentorship programs, technical seminars, career guidance, and job placement opportunities.</p>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="overflow-hidden rounded mb-3" style="height: 220px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/pust%20building.jpg" alt="PUST Building Image" style="object-fit: cover;" />
                    </div>
                    <h4 class="font-weight-bold text-dark mt-2">Give Back and Enhance Alumni Engagement</h4>
                    <p class="text-muted mt-2">Empower current students and contribute to the academic excellence and global recognition of PUST EEE.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section class="container my-5 py-3">
        <div class="text-center mb-5">
            <h2 class="font-weight-bold text-dark">Our Process</h2>
            <p class="text-muted font-weight-bold" style="font-size: 1.1rem;">We have a Simple 3 Step Process</p>
            <div style="width: 60px; height: 3px; background-color: #28a745; margin: 10px auto;"></div>
        </div>

        <div class="row text-center">
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="overflow-hidden rounded mb-3" style="height: 200px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/library.jpg" alt="Library Image" style="object-fit: cover;" />
                    </div>
                    <h4 class="font-weight-bold text-dark mt-2">1. Apply for Membership</h4>
                    <p class="text-muted mt-2">Submit your graduate details, photo, and registration online in just a few minutes.</p>
                    <a href="/registration.aspx" class="btn btn-outline-primary btn-sm mt-auto">Apply Now</a>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="overflow-hidden rounded mb-3" style="height: 200px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/Untitled987.jpg" alt="Search Member Image" style="object-fit: cover;" />
                    </div>
                    <h4 class="font-weight-bold text-dark mt-2">2. Search Member</h4>
                    <p class="text-muted mt-2">Search our online alumni directory by batch, roll number, blood group, or company.</p>
                    <a href="/alumnilist.aspx" class="btn btn-outline-success btn-sm mt-auto">Search Directory</a>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 my-3">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <div class="overflow-hidden rounded mb-3" style="height: 200px;">
                        <img class="img-fluid w-100 h-100" src="/Photo/Untitled.jpg" alt="Visit Us Image" style="object-fit: cover;" />
                    </div>
                    <h4 class="font-weight-bold text-dark mt-2">3. Visit Us</h4>
                    <p class="text-muted mt-2">Revisit our campus, attend reunions, and celebrate accomplishments together.</p>
                    <a href="/contact.aspx" class="btn btn-outline-info btn-sm mt-auto">Contact Info</a>
                </div>
            </div>
        </div>
    </section>

<%- include('partials/footer') %>
