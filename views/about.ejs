<%- include('partials/header', { title: 'পরিচিতি ও ইতিহাস (About Us)', activePage: 'about' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="page-title-banner">
                            <i class="fas fa-info-circle mr-2"></i> পরিচিতি ও লক্ষ্য - পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি
                        </div>

                        <div class="row">
                            <div class="col-12 text-justify" style="font-size: 1.05rem; line-height: 1.9;">
                                <div class="text-center mb-4">
                                    <h3 class="font-weight-bold text-dark" id="aboutTitle">
                                        ঐক্য, সৌহার্দ্য ও প্রগতির বাতিঘর
                                    </h3>
                                    <p class="text-success font-weight-bold">
                                        পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়স্থ চাঁপাইনবাবগঞ্জ জেলা সমিতি
                                    </p>
                                </div>

                                <p id="aboutHistory">
                                    পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়ে (পাবিপ্রবি) অধ্যয়নরত আম্রকাননখ্যাত চাঁপাইনবাবগঞ্জ জেলার শিক্ষার্থীদের পারস্পরিক ঐক্য, সৌহার্দ্য এবং ভ্রাতৃত্ববোধ সুদৃঢ় করার লক্ষ্য নিয়ে <strong>"পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি"</strong> প্রতিষ্ঠিত হয়। বিশ্ববিদ্যালয়ের সূচনালগ্ন থেকেই চাঁপাইনবাবগঞ্জ জেলার শিক্ষার্থীরা ক্যাম্পাসে পারস্পরিক সহায়তা, নবীনদের বরণ ও প্রবীণদের বিদায়, ক্যারিয়ার গাইডলাইন এবং জরুরি মানবিক সহায়তায় অগ্রণী ভূমিকা পালন করে আসছে।
                                </p>

                                <div class="card p-4 bg-light border my-4">
                                    <h5 class="font-weight-bold text-dark border-bottom pb-2 mb-3">
                                        <i class="fas fa-bullseye text-success mr-2"></i> আমাদের মূল উদ্দেশ্য ও কার্যক্রমসমূহ:
                                    </h5>
                                    <ul class="mb-0" id="aboutObjectivesList" style="line-height: 2;">
                                        <li><strong>পারস্পরিক ভ্রাতৃত্ব ও মেলবন্ধন:</strong> পাবিপ্রবিতে চাঁপাইনবাবগঞ্জ সদর, শিবগঞ্জ, গোমস্তাপুর, নাচোল এবং ভোলাহাট উপজেলার শিক্ষার্থীদের মধ্যে আন্তরিক সৌহার্দ্য ও যোগাযোগ বজায় রাখা।</li>
                                        <li><strong>ভর্তি ও ক্যাম্পাস সহযোগিতা:</strong> প্রতি শিক্ষাবর্ষে চাঁপাইনবাবগঞ্জ থেকে আসা নতুন ভর্তি পরীক্ষার্থী ও নবীন শিক্ষার্থীদের আবাসন, ক্যাম্পাস পরিচিতি ও মানসিক সহায়তা প্রদান।</li>
                                        <li><strong>মেস ও নিরাপদ আবাসন:</strong> পাবনা শহরে নবাগত ছাত্র ও ছাত্রীদের নিরাপদ, সুন্দর ও সাশ্রয়ী মেস ব্যবস্থা নিশ্চিতকরণ।</li>
                                        <li><strong>জরুরি রক্তদান নেটওয়ার্ক:</strong> পাবনা জেনারেল হাসপাতাল, চাঁপাইনবাবগঞ্জ আধুনিক সদর হাসপাতাল ও দেশের যেকোনো প্রান্তে সমিতির সদস্যদের মাধ্যমে জরুরি রক্ত সরবরাহ।</li>
                                        <li><strong>বার্ষিক মিলনমেলা ও ইফতার মাহফিল:</strong> প্রতি বছর নবীনবরণ, বার্ষিক বনভোজন/ট্যুর, ফল উৎসব এবং পবিত্র রমজানে ইফতার ও দোয়া মাহফিলের আয়োজন।</li>
                                        <li><strong>ক্যারিয়ার ও বিসিএস প্রস্তুতি সেল:</strong> পাবিপ্রবির চাঁপাইনবাবগঞ্জের প্রাক্তন সফল গ্র্যাজুয়েট ও বিসিএস ক্যাডারদের দিকনির্দেশনায় নিয়মিত ক্যারিয়ার সেশন পরিচালনা।</li>
                                        <li><strong>জরুরি ছাত্রকল্যাণ ফান্ড:</strong> কোনো শিক্ষার্থী বা তার পরিবারে আকস্মিক আর্থিক বা স্বাস্থ্যগত বিপর্যয় দেখা দিলে সমিতির মাধ্যমে জরুরি আর্থিক সহযোগিতা প্রদান।</li>
                                    </ul>
                                </div>

                                <h5 class="font-weight-bold text-dark mt-4">আমাদের স্লোগান:</h5>
                                <blockquote class="blockquote p-3 rounded text-center border-left" style="background-color: #f1f8f5; border-left: 5px solid var(--emerald-green) !important;">
                                    <p class="mb-0 font-weight-bold text-success font-italic" style="font-size: 1.25rem;">
                                        "ঐক্যের বন্ধনে চাঁপাইনবাবগঞ্জ, প্রগতির সোপানে পাবিপ্রবি"
                                    </p>
                                </blockquote>

                                <div class="text-center mt-5">
                                    <a href="/registration.aspx" class="btn btn-emerald btn-lg px-4 font-weight-bold shadow mr-2">
                                        <i class="fas fa-user-plus mr-1"></i> জেলা সমিতিতে যোগ দিন (নিবন্ধন)
                                    </a>
                                    <a href="/student_support.aspx" class="btn btn-navy btn-lg px-4 font-weight-bold shadow">
                                        <i class="fas fa-hands-helping mr-1"></i> শিক্ষার্থী সহায়তা সেল
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer bg-white border-0 pb-4 pl-4">
                        <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; হোমে ফিরে যান</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
$(document).ready(function() {
    var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io') || window.location.pathname.endsWith('.html');
    if (isStatic) {
        try {
            var raw = localStorage.getItem('chapainawabganj_site_settings');
            if (raw) {
                var s = JSON.parse(raw);
                if (s.about) {
                    if (s.about.about_title) $('#aboutTitle').text(s.about.about_title);
                    if (s.about.about_history) $('#aboutHistory').text(s.about.about_history);
                    if (s.about.about_objectives) {
                        var lines = s.about.about_objectives.split('\n');
                        var ul = $('#aboutObjectivesList');
                        ul.empty();
                        lines.forEach(function(l) {
                            if (l.trim()) {
                                ul.append('<li>' + l.trim().replace(/^[•\-\*]\s*/, '') + '</li>');
                            }
                        });
                    }
                }
            }
        } catch(e) {}
    }
});
</script>

