                            <div class="form-group p-3 border rounded bg-light mb-3">
                                <label class="font-weight-bold text-primary">৫. শিক্ষা সহায়তা ও কল্যাণ তহবিল (Student Welfare Fund)</label>
                                <textarea name="support_service_5" rows="2" class="form-control">অসহায় ও মেধাবী শিক্ষার্থীদের এককালীন শিক্ষা সহায়তা, সেমিস্টার ফি এবং জরুরি চিকিৎসা সহায়তায় আর্থিক ফান্ড।</textarea>
                            </div>

                            <button type="submit" class="btn btn-emerald font-weight-bold px-4 shadow-sm">
                                <i class="fas fa-save mr-1"></i> সহায়তা সেবাসমূহ সংরক্ষণ করুন
                            </button>
                        </form>
                    </div>

                </div>

            </div>
            <div class="card-footer bg-white border-0 pb-4 pl-4">
                <a href="/membermanagement.aspx" class="text-primary font-weight-bold">&lt;&lt; সদস্য ব্যবস্থাপনায় ফিরে যান</a>
            </div>
        </div>
    </div>
</section>

<!-- Modal: Add / Edit Committee Member -->
<div class="modal fade" id="modalAddCommitteeMember" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-navy text-white" style="background-color: var(--navy-blue);">
                <h5 class="modal-title font-weight-bold" id="modalCommitteeTitle">
                    <i class="fas fa-user-plus mr-1"></i> নতুন কমিটি সদস্য যোগ করুন
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form id="formCommitteeMemberModal">
                <input type="hidden" id="committeeEditIndex" value="-1" />
                <div class="modal-body p-4">
                    <div class="form-group mb-2">
                        <label class="font-weight-bold small">সদস্যের নাম (Full Name)</label>
                        <input type="text" id="comMemberName" class="form-control form-control-sm" placeholder="যেমন: মো: হাসিবুল হাসান" required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="font-weight-bold small text-success">পদবি / ভূমিকা (Role in Committee)</label>
                        <input type="text" id="comMemberRole" class="form-control form-control-sm" placeholder="যেমন: সভাপতি (President)" required />
                    </div>
                    <div class="row">
                        <div class="col-6 form-group mb-2">
                            <label class="font-weight-bold small">বিভাগ (Dept)</label>
                            <input type="text" id="comMemberDept" class="form-control form-control-sm" placeholder="যেমন: CSE" required />
                        </div>
                        <div class="col-6 form-group mb-2">
                            <label class="font-weight-bold small">সেশন (Session)</label>
                            <input type="text" id="comMemberSession" class="form-control form-control-sm" placeholder="যেমন: 2019-20" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 form-group mb-2">
                            <label class="font-weight-bold small">নিজ উপজেলা</label>
                            <select id="comMemberUpazila" class="form-control form-control-sm">
                                <option value="Chapainawabganj Sadar">চাঁপাইনবাবগঞ্জ সদর</option>
                                <option value="Shibganj">শিবগঞ্জ</option>
                                <option value="Gomostapur">গোমস্তাপুর</option>
                                <option value="Nachole">নাচোল</option>
                                <option value="Bholahat">ভোলাহাট</option>
                            </select>
                        </div>
                        <div class="col-6 form-group mb-2">
                            <label class="font-weight-bold small">মোবাইল নম্বর</label>
                            <input type="text" id="comMemberPhone" class="form-control form-control-sm" placeholder="01700000001" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">বাতিল</button>
                    <button type="submit" class="btn btn-emerald btn-sm font-weight-bold px-3">
                        <i class="fas fa-check mr-1"></i> সংরক্ষণ করুন
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var defaultCommittee = [
        {
            role: "সভাপতি (President)",
            name: "মো: হাসিবুল হাসান",
            department: "CSE",
            session: "2019-20",
            upazila: "Shibganj",
            phone: "+8801700000001"
        },
        {
            role: "সাধারণ সম্পাদক (General Secretary)",
            name: "মো: আবদুল্লাহ আল মামুন",
            department: "EEE",
            session: "2020-21",
            upazila: "Chapainawabganj Sadar",
            phone: "+8801700000002"
        },
        {
            role: "সাংগঠনিক সম্পাদক (Organizing Secretary)",
            name: "মো: আরিফুল ইসলাম",
            department: "Pharmacy",
            session: "2021-22",
            upazila: "Gomostapur",
            phone: "+8801700000003"
        },
        {
            role: "দপ্তর সম্পাদক (Office Secretary)",
            name: "মো: ফাহিম ফয়সাল",
            department: "CE",
            session: "2021-22",
            upazila: "Nachole",
            phone: "+8801700000004"
        },
        {
            role: "ছাত্রকল্যাণ ও রক্তদান বিষয়ক সম্পাদক",
            name: "মো: রাকিবুল ইসলাম",
            department: "BBA",
            session: "2022-23",
            upazila: "Bholahat",
            phone: "+8801700000005"
        }
    ];

    function getSiteSettings() {
        try {
            var raw = localStorage.getItem('chapainawabganj_site_settings');
            if (raw) return JSON.parse(raw);
        } catch(e) {}
        return null;
    }

    function getCommitteeMembers() {
        try {
            var raw = localStorage.getItem('chapainawabganj_committee_data');
            if (raw) {
                var parsed = JSON.parse(raw);
                if (Array.isArray(parsed) && parsed.length > 0) return parsed;
            }
        } catch(e) {}
        return defaultCommittee;
    }

    function saveCommitteeMembers(list) {
        localStorage.setItem('chapainawabganj_committee_data', JSON.stringify(list));
        renderCommitteeTable();
    }

    function renderCommitteeTable() {
        var list = getCommitteeMembers();
        var tbody = $('#committeeTableBody');
        tbody.empty();

        list.forEach(function(m, idx) {
            var tr = $('<tr></tr>');
            tr.html(
                '<td class="align-middle text-center"><img src="Photo/fahim.png" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src=\'Photo/fahim.png\'" /></td>' +
                '<td class="align-middle"><strong>' + m.name + '</strong><br><span class="badge badge-emerald text-white px-2 py-1 font-weight-bold">' + m.role + '</span></td>' +
                '<td class="align-middle">' + m.department + '<br><small class="badge badge-session">' + m.session + ' সেশন</small></td>' +
                '<td class="align-middle"><span class="badge badge-upazila">' + m.upazila + '</span></td>' +
                '<td class="align-middle"><a href="tel:' + m.phone + '" class="text-success font-weight-bold"><i class="fas fa-phone mr-1"></i>' + m.phone + '</a></td>' +
                '<td class="align-middle text-center">' +
                    '<div class="btn-group btn-group-sm">' +
                        '<button class="btn btn-outline-primary btn-edit-com" data-index="' + idx + '" title="এডিট"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-outline-danger btn-delete-com" data-index="' + idx + '" title="মুছুন"><i class="fas fa-trash-alt"></i></button>' +
                    '</div>' +
                '</td>'
            );
            tbody.append(tr);
        });
    }

    // Load initial values from localStorage if available
    var savedSettings = getSiteSettings();
    if (savedSettings) {
        if (savedSettings.general) {
            $('input[name="site_title"]').val(savedSettings.general.site_title || '');
            $('input[name="site_tagline"]').val(savedSettings.general.site_tagline || '');
            $('input[name="contact_phone"]').val(savedSettings.general.contact_phone || '');
            $('input[name="contact_email"]').val(savedSettings.general.contact_email || '');
            $('input[name="blood_hotline"]').val(savedSettings.general.blood_hotline || '');
            $('input[name="facebook_url"]').val(savedSettings.general.facebook_url || '');
            $('textarea[name="office_address"]').val(savedSettings.general.office_address || '');
        }
        if (savedSettings.home) {
            $('input[name="hero_title"]').val(savedSettings.home.hero_title || '');
            $('textarea[name="hero_subtitle"]').val(savedSettings.home.hero_subtitle || '');
            $('input[name="welcome_heading"]').val(savedSettings.home.welcome_heading || '');
            $('textarea[name="welcome_text"]').val(savedSettings.home.welcome_text || '');
        }
        if (savedSettings.about) {
            $('input[name="about_title"]').val(savedSettings.about.about_title || '');
            $('textarea[name="about_history"]').val(savedSettings.about.about_history || '');
            $('textarea[name="about_objectives"]').val(savedSettings.about.about_objectives || '');
        }
        if (savedSettings.support) {
            $('textarea[name="support_service_1"]').val(savedSettings.support.service_1 || '');
            $('textarea[name="support_service_2"]').val(savedSettings.support.service_2 || '');
            $('textarea[name="support_service_3"]').val(savedSettings.support.service_3 || '');
            $('textarea[name="support_service_4"]').val(savedSettings.support.service_4 || '');
            $('textarea[name="support_service_5"]').val(savedSettings.support.service_5 || '');
        }
    }

    // Save General Settings
    $('#formGeneralSettings').on('submit', function(e) {
        e.preventDefault();
        var current = getSiteSettings() || {};
        current.general = {
            site_title: $('input[name="site_title"]').val(),
            site_tagline: $('input[name="site_tagline"]').val(),
            contact_phone: $('input[name="contact_phone"]').val(),
            contact_email: $('input[name="contact_email"]').val(),
            blood_hotline: $('input[name="blood_hotline"]').val(),
            facebook_url: $('input[name="facebook_url"]').val(),
            office_address: $('textarea[name="office_address"]').val()
        };
        localStorage.setItem('chapainawabganj_site_settings', JSON.stringify(current));
        alert('সাধারণ ও যোগাযোগের তথ্য সফলভাবে সংরক্ষিত হয়েছে!');
    });

    // Save Home Page Settings
    $('#formHomeSettings').on('submit', function(e) {
        e.preventDefault();
        var current = getSiteSettings() || {};
        current.home = {
            hero_title: $('input[name="hero_title"]').val(),
            hero_subtitle: $('textarea[name="hero_subtitle"]').val(),
            welcome_heading: $('input[name="welcome_heading"]').val(),
            welcome_text: $('textarea[name="welcome_text"]').val()
        };
        localStorage.setItem('chapainawabganj_site_settings', JSON.stringify(current));
        alert('হোম পেজ ও ব্যানারের তথ্য সফলভাবে সংরক্ষিত হয়েছে!');
    });

    // Save About Settings
    $('#formAboutSettings').on('submit', function(e) {
        e.preventDefault();
        var current = getSiteSettings() || {};
        current.about = {
            about_title: $('input[name="about_title"]').val(),
            about_history: $('textarea[name="about_history"]').val(),
            about_objectives: $('textarea[name="about_objectives"]').val()
        };
        localStorage.setItem('chapainawabganj_site_settings', JSON.stringify(current));
        alert('পরিচিতি ও ইতিহাসের তথ্য সফলভাবে সংরক্ষিত হয়েছে!');
    });

    // Save Support Services
    $('#formSupportSettings').on('submit', function(e) {
        e.preventDefault();
        var current = getSiteSettings() || {};
        current.support = {
            service_1: $('textarea[name="support_service_1"]').val(),
            service_2: $('textarea[name="support_service_2"]').val(),
            service_3: $('textarea[name="support_service_3"]').val(),
            service_4: $('textarea[name="support_service_4"]').val(),
            service_5: $('textarea[name="support_service_5"]').val()
        };
        localStorage.setItem('chapainawabganj_site_settings', JSON.stringify(current));
        alert('শিক্ষার্থী সহায়তা সেবাসমূহ সফলভাবে সংরক্ষিত হয়েছে!');
    });

    // Committee Session Update
    var savedSession = localStorage.getItem('chapainawabganj_committee_session');
    if (savedSession) $('#inputCommitteeSession').val(savedSession);

    $('#btnSaveCommitteeSession').on('click', function() {
        var ses = $('#inputCommitteeSession').val().trim();
        if (ses) {
            localStorage.setItem('chapainawabganj_committee_session', ses);
            alert('কমিটির মেয়াদ/সেশন "' + ses + '" আপডেট হয়েছে!');
        }
    });

    // Add / Edit Committee Member Modal
    $('#formCommitteeMemberModal').on('submit', function(e) {
        e.preventDefault();
        var list = getCommitteeMembers();
        var editIdx = parseInt($('#committeeEditIndex').val(), 10);

        var memberObj = {
            name: $('#comMemberName').val().trim(),
            role: $('#comMemberRole').val().trim(),
            department: $('#comMemberDept').val().trim(),
            session: $('#comMemberSession').val().trim(),
            upazila: $('#comMemberUpazila').val(),
            phone: $('#comMemberPhone').val().trim()
        };

        if (editIdx >= 0 && editIdx < list.length) {
            list[editIdx] = memberObj;
            alert('কমিটি সদস্য "' + memberObj.name + '" এর তথ্য আপডেট হয়েছে!');
        } else {
            list.push(memberObj);
            alert('নতুন কমিটি সদস্য "' + memberObj.name + '" যুক্ত করা হয়েছে!');
        }

        saveCommitteeMembers(list);
        $('#modalAddCommitteeMember').modal('hide');
        $('#formCommitteeMemberModal')[0].reset();
        $('#committeeEditIndex').val('-1');
        $('#modalCommitteeTitle').html('<i class="fas fa-user-plus mr-1"></i> নতুন কমিটি সদস্য যোগ করুন');
    });

    // Click Edit on Committee Member
    $(document).on('click', '.btn-edit-com', function() {
        var idx = $(this).data('index');
        var list = getCommitteeMembers();
        var m = list[idx];
        if (m) {
            $('#committeeEditIndex').val(idx);
            $('#modalCommitteeTitle').html('<i class="fas fa-user-edit mr-1"></i> কমিটি সদস্য তথ্য এডিট');
            $('#comMemberName').val(m.name);
            $('#comMemberRole').val(m.role);
            $('#comMemberDept').val(m.department);
            $('#comMemberSession').val(m.session);
            $('#comMemberUpazila').val(m.upazila);
            $('#comMemberPhone').val(m.phone);
            $('#modalAddCommitteeMember').modal('show');
        }
    });

    // Click Delete on Committee Member
    $(document).on('click', '.btn-delete-com', function() {
        var idx = $(this).data('index');
        var list = getCommitteeMembers();
        var m = list[idx];
        if (m && confirm('আপনি কি নিশ্চিত যে ' + m.name + ' কে কমিটি থেকে বাদ দিতে চান?')) {
            list.splice(idx, 1);
            saveCommitteeMembers(list);
            alert('কমিটি সদস্যকে তালিকা থেকে বাদ দেওয়া হয়েছে!');
        }
    });

    renderCommitteeTable();
});
</script>

<%- include('partials/footer') %>
