<script>
$(document).ready(function() {
    var isStatic = window.location.protocol === 'file:' || window.location.hostname.includes('github.io') || window.location.pathname.endsWith('.html');
    if (isStatic) {
        var student = null;
        try {
            var rawUser = sessionStorage.getItem('chapainawabganj_current_user') || localStorage.getItem('chapainawabganj_current_user');
            if (rawUser) student = JSON.parse(rawUser);
            if (!student) {
                var loginId = sessionStorage.getItem('chapainawabganj_user_logged_in') || localStorage.getItem('chapainawabganj_user_logged_in');
                var localRaw = localStorage.getItem('chapainawabganj_local_members');
                var list = localRaw ? JSON.parse(localRaw) : [];
                if (loginId) {
                    for (var i = 0; i < list.length; i++) {
                        if (String(list[i].student_id) === String(loginId) || String(list[i].email) === String(loginId) || String(list[i].contact_number) === String(loginId)) {
                            student = list[i];
                            break;
                        }
                    }
                }
                if (!student && list.length > 0) {
                    student = list[0];
                }
            }
        } catch(e) {}

        if (student) {
            try {
                var overridesRaw = localStorage.getItem('chapainawabganj_status_overrides');
                if (overridesRaw) {
                    var ov = JSON.parse(overridesRaw);
                    var sKey = String(student.id || student.student_id);
                    if (ov[sKey]) student.status = ov[sKey];
                }
            } catch(e) {}

            var photo = student.profile_photo || 'Photo/fahim.png';
            $('.position-relative img').attr('src', photo);
            $('.position-relative .badge')
                .removeClass('badge-success badge-warning')
                .addClass(student.status === 'Active' ? 'badge-success' : 'badge-warning')
