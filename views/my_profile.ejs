<%- include('partials/header', { title: 'আমার প্রোফাইল ও আইডি কার্ড (User Panel)', activePage: 'my_profile' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row">
            
            <!-- Left Sidebar: Profile Summary & Digital Student ID Card -->
            <div class="col-lg-5 mb-4">
                <!-- Member Card -->
                <div class="card shadow-sm border-0 text-center mb-4">
                    <div class="card-body p-4">
                        <div class="position-relative d-inline-block mb-3">
                            <img src="/<%= member.profile_photo || 'Photo/fahim.png' %>" alt="<%= member.full_name %>" class="rounded-circle border border-success p-1 shadow" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                            <span class="badge badge-<%= member.status === 'Active' ? 'success' : 'warning' %> position-absolute font-weight-bold" style="bottom: 0; right: 0; font-size: 13px; padding: 6px 12px; border-radius: 20px;">
                                <i class="fas fa-<%= member.status === 'Active' ? 'check-circle' : 'clock' %> mr-1"></i>
                                <%= member.status === 'Active' ? 'সক্রিয় সদস্য' : 'পেন্ডিং ভেরিফিকেশন' %>
                            </span>
                        </div>
                        <h4 class="font-weight-bold text-dark mb-1"><%= member.full_name %></h4>
                        <p class="text-muted mb-2"><%= member.department %></p>
                        <p class="mb-3">
                            <span class="badge badge-session px-3 py-1 font-weight-bold"><%= member.session %> সেশন</span>
                            <span class="badge badge-upazila px-3 py-1 font-weight-bold"><i class="fas fa-map-marker-alt mr-1"></i> <%= member.upazila %></span>
                        </p>

                        <% if (member.status === 'Pending') { %>
                            <div class="alert alert-warning text-left small mb-3">
                                <i class="fas fa-info-circle mr-1"></i> <strong>ভেরিফিকেশন অপেক্ষমান:</strong> কেন্দ্রীয় অ্যাডমিন প্যানেল থেকে আপনার প্রাতিষ্ঠানিক তথ্য যাচাই শেষে আপনার প্রোফাইল সম্পূর্ণ সক্রিয় করা হবে।
                            </div>
                        <% } %>

                        <hr>

                        <div class="text-left" style="font-size: 14px; line-height: 1.8;">
                            <p class="mb-2"><strong><i class="fas fa-id-badge text-primary mr-2"></i> স্টুডেন্ট আইডি:</strong> <%= member.student_id || member.roll_no %></p>
                            <p class="mb-2"><strong><i class="fas fa-tint text-danger mr-2"></i> রক্তের গ্রুপ:</strong> <span class="badge badge-blood"><%= member.blood_group || 'N/A' %></span></p>
                            <p class="mb-2"><strong><i class="fas fa-phone text-success mr-2"></i> মোবাইল:</strong> <%= member.contact_number %></p>
                            <p class="mb-2"><strong><i class="fas fa-envelope text-info mr-2"></i> ইমেইল:</strong> <%= member.email %></p>
                            <p class="mb-2"><strong><i class="fas fa-hotel text-warning mr-2"></i> হল / মেস:</strong> <%= member.hall || 'N/A' %></p>
                            <p class="mb-0"><strong><i class="fas fa-briefcase text-secondary mr-2"></i> বর্তমান পেশা:</strong> <%= member.profession %></p>
                        </div>
                    </div>
                </div>

                <!-- Digital Student Membership ID Card -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-navy text-white font-weight-bold text-center" style="background-color: var(--navy-blue);">
                        <i class="fas fa-id-card mr-2 text-warning"></i> ডিজিটাল স্টুডেন্ট মেম্বারশিপ কার্ড
                    </div>
                    <div class="card-body p-3 text-center">
                        <div class="id-card-preview text-left p-3 position-relative" id="studentCard">
                            <!-- Card Header -->
                            <div class="d-flex align-items-center border-bottom pb-2 mb-2">
                                <img src="/Photo/me.png" alt="PUST" style="height: 42px; width: auto;" onerror="this.src='/Photo/me.png'">
                                <div class="ml-2">
                                    <h6 class="font-weight-bold m-0" style="font-size: 13px; color: #ffffff; letter-spacing: 0.3px;">পাবিপ্রবি চাঁপাইনবাবগঞ্জ জেলা সমিতি</h6>
                                    <small style="font-size: 10px; color: #a7f3d0; text-transform: uppercase;">Chapainabjanj Jelashomiti PUST</small>
                                </div>
                            </div>
                            <!-- Card Body -->
                            <div class="row align-items-center">
                                <div class="col-4 text-center">
                                    <img src="/<%= member.profile_photo || 'Photo/fahim.png' %>" class="rounded border border-light shadow-sm" style="width: 80px; height: 90px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'">
                                    <div class="mt-1 badge badge-danger font-weight-bold" style="font-size: 10px;">
                                        <%= member.blood_group || 'Blood N/A' %>
                                    </div>
                                </div>
                                <div class="col-8 pl-1" style="font-size: 11px; line-height: 1.5; color: #f1f5f9;">
                                    <h6 class="font-weight-bold mb-1 text-white" style="font-size: 14px;"><%= member.full_name %></h6>
                                    <div class="mb-1"><strong>আইডি:</strong> <%= member.student_id || member.roll_no %></div>
                                    <div class="mb-1"><strong>বিভাগ:</strong> <%= member.department.split('(')[0] %></div>
                                    <div class="mb-1"><strong>সেশন:</strong> <%= member.session %></div>
                                    <div class="mb-1"><strong>উপজেলা:</strong> <%= member.upazila %></div>
                                    <div class="mb-0"><strong>কার্ড নং:</strong> <%= member.membership_id || 'CP-PUST-' + (member.student_id || member.roll_no) %></div>
                                </div>
                            </div>
                            <!-- Card Footer -->
                            <div class="border-top pt-1 mt-2 d-flex justify-content-between align-items-center" style="font-size: 9px; color: #cbd5e1;">
                                <span>সদস্য স্ট্যাটাস: <strong><%= member.status === 'Active' ? 'সক্রিয় (Active)' : 'ভেরিফিকেশন অপেক্ষমান' %></strong></span>
                                <span>পাবনা বিজ্ঞান ও প্রযুক্তি বিশ্ববিদ্যালয়</span>
                            </div>
                        </div>

                        <button onclick="window.print();" class="btn btn-outline-emerald btn-sm btn-block mt-3 font-weight-bold">
                            <i class="fas fa-print mr-1"></i> ডিজিটাল আইডি কার্ড প্রিন্ট / সংরক্ষণ করুন
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Area: Profile Editing & Account Details -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom p-0">
                        <ul class="nav nav-tabs card-header-tabs m-0 border-0" id="profileTabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active font-weight-bold px-4 py-3" id="general-tab" data-toggle="tab" href="#general" role="tab">
                                    <i class="fas fa-user-edit mr-1 text-success"></i> তথ্য সংশোধন (Edit Profile)
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link font-weight-bold px-4 py-3" id="security-tab" data-toggle="tab" href="#security" role="tab">
                                    <i class="fas fa-lock mr-1 text-danger"></i> পাসওয়ার্ড পরিবর্তন
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-4">
                        <div class="tab-content" id="profileTabContent">

                            <!-- Tab 1: Edit Profile -->
                            <div class="tab-pane fade show active" id="general" role="tabpanel">
                                <form action="/my_profile.aspx" method="POST" enctype="multipart/form-data">
                                    <input type="hidden" name="action" value="update_profile" />

                                    <h5 class="font-weight-bold mb-3" style="color: var(--navy-blue);">ব্যক্তিগত ও যোগাযোগের তথ্য</h5>
                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">পূর্ণ নাম (Full Name)</label>
                                            <input type="text" name="full_name" class="form-control" value="<%= member.full_name %>" required />
                                        </div>
                                        <div class="col-md-3 form-group">
                                            <label class="font-weight-bold">রক্তের গ্রুপ</label>
                                            <input type="text" name="blood_group" class="form-control" value="<%= member.blood_group %>" />
                                        </div>
                                        <div class="col-md-3 form-group">
                                            <label class="font-weight-bold">লিঙ্গ</label>
                                            <select name="gender" class="form-control">
                                                <option value="Male" <%= member.gender === 'Male' ? 'selected' : '' %>>পুরুষ</option>
                                                <option value="Female" <%= member.gender === 'Female' ? 'selected' : '' %>>নারী</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">মোবাইল নম্বর</label>
                                            <input type="text" name="contact_number" class="form-control" value="<%= member.contact_number %>" required />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">ইমেইল ঠিকানা</label>
                                            <input type="email" name="email" class="form-control" value="<%= member.email %>" required />
                                        </div>
                                    </div>

                                    <h5 class="font-weight-bold mt-4 mb-3" style="color: var(--navy-blue);">প্রাতিষ্ঠানিক ও ভৌগোলিক তথ্য</h5>
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label class="font-weight-bold">স্টুডেন্ট আইডি / রোল</label>
                                            <input type="text" class="form-control bg-light" value="<%= member.student_id || member.roll_no %>" readonly />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label class="font-weight-bold">সেশন</label>
                                            <input type="text" class="form-control bg-light" value="<%= member.session %>" readonly />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label class="font-weight-bold">নিজ উপজেলা</label>
                                            <select name="upazila" class="form-control">
                                                <option value="Chapainawabganj Sadar" <%= member.upazila === 'Chapainawabganj Sadar' ? 'selected' : '' %>>চাঁপাইনবাবগঞ্জ সদর</option>
                                                <option value="Shibganj" <%= member.upazila === 'Shibganj' ? 'selected' : '' %>>শিবগঞ্জ</option>
                                                <option value="Gomostapur" <%= member.upazila === 'Gomostapur' ? 'selected' : '' %>>গোমস্তাপুর</option>
                                                <option value="Nachole" <%= member.upazila === 'Nachole' ? 'selected' : '' %>>নাচোল</option>
                                                <option value="Bholahat" <%= member.upazila === 'Bholahat' ? 'selected' : '' %>>ভোলাহাট</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">বর্তমান পেশা / অবস্থান</label>
                                            <input type="text" name="profession" class="form-control" value="<%= member.profession %>" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">পাবনায় আবাসিক হল / মেস</label>
                                            <input type="text" name="hall" class="form-control" value="<%= member.hall %>" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="font-weight-bold">বর্তমান পূর্ণ ঠিকানা (Present Address)</label>
                                        <textarea name="present_address" rows="2" class="form-control"><%= member.present_address %></textarea>
                                    </div>

                                    <div class="form-group p-3 rounded" style="background-color: #f1f8f5; border: 1px dashed var(--emerald-green);">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="is_blood_donor" id="donorCheck" value="yes" <%= member.is_blood_donor ? 'checked' : '' %> />
                                            <label class="form-check-label font-weight-bold text-dark" for="donorCheck">
                                                <i class="fas fa-heartbeat text-danger mr-1"></i> জরুরি প্রয়োজনে রক্তদানে সক্রিয় রক্তদাতা হিসেবে থাকুন
                                            </label>
                                        </div>
                                    </div>

                                    <div class="form-group mt-3">
                                        <label class="font-weight-bold">প্রোফাইল ছবি পরিবর্তন করুন</label>
                                        <input type="file" name="profile_photo" class="form-control-file" accept="image/*" />
                                    </div>

                                    <button type="submit" class="btn btn-emerald font-weight-bold px-4 py-2 mt-3 shadow-sm">
                                        <i class="fas fa-save mr-1"></i> তথ্য সংরক্ষণ করুন
                                    </button>
                                </form>
                            </div>

                            <!-- Tab 2: Security & Password -->
                            <div class="tab-pane fade" id="security" role="tabpanel">
                                <h5 class="font-weight-bold mb-3 text-dark">লগইন পাসওয়ার্ড পরিবর্তন</h5>
                                <form action="/my_profile.aspx" method="POST">
                                    <input type="hidden" name="action" value="change_password" />

                                    <div class="form-group">
                                        <label class="font-weight-bold">বর্তমান পাসওয়ার্ড</label>
                                        <input type="password" name="current_password" class="form-control" placeholder="বর্তমান পাসওয়ার্ড লিখুন" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">নতুন পাসওয়ার্ড</label>
                                        <input type="password" name="new_password" class="form-control" placeholder="কমপক্ষে ৬ অক্ষরের নতুন পাসওয়ার্ড" minlength="6" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">নতুন পাসওয়ার্ড নিশ্চিত করুন</label>
                                        <input type="password" name="confirm_password" class="form-control" placeholder="পুনরায় নতুন পাসওয়ার্ড লিখুন" minlength="6" required />
                                    </div>

                                    <button type="submit" class="btn btn-danger font-weight-bold px-4 py-2 shadow-sm">
                                        <i class="fas fa-key mr-1"></i> পাসওয়ার্ড আপডেট করুন
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<%- include('partials/footer') %>
