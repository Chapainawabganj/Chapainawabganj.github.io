<%- include('partials/header', { title: 'My Profile & User Panel', activePage: 'my_profile' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row">
            
            <!-- Left Sidebar: Profile Summary & Digital ID Card -->
            <div class="col-lg-4 mb-4">
                <!-- Member Card -->
                <div class="card shadow-sm border-0 text-center mb-4">
                    <div class="card-body p-4">
                        <div class="position-relative d-inline-block mb-3">
                            <img src="/<%= member.profile_photo || 'Photo/fahim.png' %>" alt="<%= member.full_name %>" class="rounded-circle border border-primary p-1 shadow" style="width: 120px; height: 120px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'" />
                            <span class="badge badge-<%= member.status === 'Active' ? 'success' : 'warning' %> position-absolute" style="bottom: 0; right: 0; font-size: 13px; padding: 5px 10px;">
                                <%= member.status %>
                            </span>
                        </div>
                        <h4 class="font-weight-bold text-dark mb-1"><%= member.full_name %></h4>
                        <p class="text-muted mb-2"><%= member.degree || 'B.Sc in EEE' %></p>
                        <p class="mb-3">
                            <span class="badge badge-primary px-3 py-1 font-weight-bold"><%= member.membership_type || 'Member' %></span>
                            <span class="badge badge-secondary px-3 py-1">Roll: <%= member.roll_no %></span>
                        </p>

                        <hr>

                        <div class="text-left" style="font-size: 14px;">
                            <p class="mb-2"><strong><i class="fas fa-layer-group text-primary mr-2"></i> Batch:</strong> <%= member.batch_no %> Batch</p>
                            <p class="mb-2"><strong><i class="fas fa-id-card text-success mr-2"></i> Membership ID:</strong> <%= member.membership_no || 'MEM-' + member.roll_no %></p>
                            <p class="mb-2"><strong><i class="fas fa-envelope text-info mr-2"></i> Email:</strong> <%= member.email %></p>
                            <p class="mb-2"><strong><i class="fas fa-phone text-warning mr-2"></i> Phone:</strong> <%= member.contact_number %></p>
                            <p class="mb-2"><strong><i class="fas fa-tint text-danger mr-2"></i> Blood Group:</strong> <%= member.blood_group || 'Not set' %></p>
                            <p class="mb-0"><strong><i class="fas fa-building text-secondary mr-2"></i> Organization:</strong> <%= member.organization || 'Not set' %></p>
                        </div>
                    </div>
                </div>

                <!-- Digital Alumni ID Card Preview -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-dark text-white font-weight-bold">
                        <i class="fas fa-id-badge mr-2"></i> Digital Alumni ID Card
                    </div>
                    <div class="card-body p-3 text-center">
                        <div class="id-card-preview text-left p-3 position-relative" id="alumniCard" style="background: linear-gradient(135deg, #0b2545 0%, #134074 100%); color: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                            <div class="d-flex align-items-center border-bottom pb-2 mb-2">
                                <img src="/Photo/me.png" alt="PUST" style="height: 38px; width: 38px;" onerror="this.src='/Photo/pust-eee.png'">
                                <div class="ml-2">
                                    <h6 class="font-weight-bold m-0" style="font-size: 13px; letter-spacing: 0.5px;">PUST EEE ALUMNI</h6>
                                    <small style="font-size: 10px; color: #8da9c4;">Pabna University of Science &amp; Technology</small>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <div class="col-4 text-center">
                                    <img src="/<%= member.profile_photo || 'Photo/fahim.png' %>" class="rounded border" style="width: 75px; height: 85px; object-fit: cover;" onerror="this.src='/Photo/fahim.png'">
                                    <div class="mt-1" style="font-size: 9px; color: #eef4f8;"><%= member.blood_group || 'Blood N/A' %></div>
                                </div>
                                <div class="col-8 pl-1" style="font-size: 11px;">
                                    <h6 class="font-weight-bold mb-1 text-white" style="font-size: 13px;"><%= member.full_name %></h6>
                                    <div class="mb-1"><strong>Roll:</strong> <%= member.roll_no %></div>
                                    <div class="mb-1"><strong>Batch:</strong> <%= member.batch_no %> Batch</div>
                                    <div class="mb-1"><strong>Type:</strong> <%= member.membership_type %></div>
                                    <div class="mb-0"><strong>ID:</strong> <%= member.membership_no || 'MEM-' + member.roll_no %></div>
                                </div>
                            </div>
                            <div class="border-top pt-1 mt-2 text-center" style="font-size: 9px; color: #8da9c4;">
                                Official Member &bull; Alumni Association
                            </div>
                        </div>

                        <button onclick="window.print();" class="btn btn-outline-primary btn-sm btn-block mt-3 font-weight-bold">
                            <i class="fas fa-print mr-1"></i> Print / Save ID Card
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Area: Profile Editing & Tabs -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom p-0">
                        <ul class="nav nav-tabs card-header-tabs m-0 border-0" id="profileTabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active font-weight-bold px-4 py-3" id="general-tab" data-toggle="tab" href="#general" role="tab">
                                    <i class="fas fa-user-edit mr-1"></i> Edit Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link font-weight-bold px-4 py-3" id="documents-tab" data-toggle="tab" href="#documents" role="tab">
                                    <i class="fas fa-file-upload mr-1"></i> My Documents
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link font-weight-bold px-4 py-3" id="security-tab" data-toggle="tab" href="#security" role="tab">
                                    <i class="fas fa-key mr-1"></i> Change Password
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-4">
                        <div class="tab-content" id="profileTabContent">

                            <!-- Tab 1: Edit Profile -->
                            <div class="tab-pane fade show active" id="general" role="tabpanel">
                                <form action="/my_profile.aspx" method="POST" enctype="multipart/form-data">
                                    <input type="hidden" name="action" value="update_profile" />

                                    <h5 class="text-primary font-weight-bold mb-3">Personal &amp; Contact Details</h5>
                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Full Name</label>
                                            <input type="text" name="full_name" class="form-control" value="<%= member.full_name %>" required />
                                        </div>
                                        <div class="col-md-3 form-group">
                                            <label class="font-weight-bold">Gender</label>
                                            <select name="gender" class="form-control">
                                                <option value="Male" <%= member.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                                <option value="Female" <%= member.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 form-group">
                                            <label class="font-weight-bold">Blood Group</label>
                                            <input type="text" name="blood_group" class="form-control" value="<%= member.blood_group %>" placeholder="e.g. A+" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Email Address</label>
                                            <input type="email" name="email" class="form-control" value="<%= member.email %>" required />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Contact Number</label>
                                            <input type="text" name="contact_number" class="form-control" value="<%= member.contact_number %>" required />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Facebook Profile</label>
                                            <input type="url" name="facebook" class="form-control" value="<%= member.facebook %>" placeholder="https://facebook.com/..." />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">LinkedIn Profile</label>
                                            <input type="url" name="linkedin" class="form-control" value="<%= member.linkedin %>" placeholder="https://linkedin.com/in/..." />
                                        </div>
                                    </div>

                                    <h5 class="text-primary font-weight-bold mt-4 mb-3">Academic &amp; Professional Details</h5>
                                    <div class="row">
                                        <div class="col-md-4 form-group">
                                            <label class="font-weight-bold">Roll Number</label>
                                            <input type="text" class="form-control bg-light" value="<%= member.roll_no %>" readonly />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label class="font-weight-bold">Batch</label>
                                            <input type="text" class="form-control bg-light" value="<%= member.batch_no %> Batch" readonly />
                                        </div>
                                        <div class="col-md-4 form-group">
                                            <label class="font-weight-bold">Residential Hall</label>
                                            <input type="text" name="hall" class="form-control" value="<%= member.hall %>" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Organization</label>
                                            <input type="text" name="organization" class="form-control" value="<%= member.organization %>" />
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Designation</label>
                                            <input type="text" name="designation" class="form-control" value="<%= member.designation %>" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Present District &amp; Address</label>
                                            <input type="text" name="present_district" class="form-control mb-2" value="<%= member.present_district %>" placeholder="District" />
                                            <textarea name="present_address" rows="2" class="form-control" placeholder="Present Address"><%= member.present_address %></textarea>
                                        </div>
                                        <div class="col-md-6 form-group">
                                            <label class="font-weight-bold">Permanent District &amp; Address</label>
                                            <input type="text" name="permanent_district" class="form-control mb-2" value="<%= member.permanent_district %>" placeholder="District" />
                                            <textarea name="permanent_address" rows="2" class="form-control" placeholder="Permanent Address"><%= member.permanent_address %></textarea>
                                        </div>
                                    </div>

                                    <div class="form-group mt-3">
                                        <label class="font-weight-bold">Update Profile Photo</label>
                                        <input type="file" name="profile_photo" class="form-control-file" accept="image/*" />
                                    </div>

                                    <button type="submit" class="btn btn-primary font-weight-bold px-4 py-2 mt-3 shadow-sm">
                                        <i class="fas fa-save mr-1"></i> Save Changes
                                    </button>
                                </form>
                            </div>

                            <!-- Tab 2: My Documents -->
                            <div class="tab-pane fade" id="documents" role="tabpanel">
                                <h5 class="text-primary font-weight-bold mb-3">Verification &amp; Uploaded Documents</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <div class="card p-3 bg-light border">
                                            <h6 class="font-weight-bold text-dark"><i class="fas fa-certificate text-warning mr-2"></i> Degree Certificate</h6>
                                            <p class="text-muted small mb-2">Serial: <%= member.cert_serial_no || 'Not recorded' %></p>
                                            <% if (member.cert_photo) { %>
                                                <a href="/<%= member.cert_photo %>" class="btn btn-outline-primary btn-sm" target="_blank">
                                                    <i class="fas fa-external-link-alt mr-1"></i> View Certificate
                                                </a>
                                            <% } else { %>
                                                <span class="badge badge-secondary p-2">No certificate file uploaded</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="card p-3 bg-light border">
                                            <h6 class="font-weight-bold text-dark"><i class="fas fa-receipt text-success mr-2"></i> Payment Slip / Receipt</h6>
                                            <p class="text-muted small mb-2">Method: <%= member.payment_method || 'Online Payment' %></p>
                                            <% if (member.payment_photo) { %>
                                                <a href="/<%= member.payment_photo %>" class="btn btn-outline-success btn-sm" target="_blank">
                                                    <i class="fas fa-external-link-alt mr-1"></i> View Payment Document
                                                </a>
                                            <% } else { %>
                                                <span class="badge badge-secondary p-2">No payment slip uploaded</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info mt-3">
                                    <i class="fas fa-info-circle mr-1"></i> To replace your certificate or payment slip, please contact the alumni administrator or visit the contact page.
                                </div>
                            </div>

                            <!-- Tab 3: Security & Password -->
                            <div class="tab-pane fade" id="security" role="tabpanel">
                                <h5 class="text-primary font-weight-bold mb-3">Change Your Account Password</h5>
                                <form action="/my_profile.aspx" method="POST">
                                    <input type="hidden" name="action" value="change_password" />

                                    <div class="form-group">
                                        <label class="font-weight-bold">Current Password</label>
                                        <input type="password" name="current_password" class="form-control" placeholder="Enter current password" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">New Password</label>
                                        <input type="password" name="new_password" class="form-control" placeholder="At least 6 characters" minlength="6" required />
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold">Confirm New Password</label>
                                        <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter new password" minlength="6" required />
                                    </div>

                                    <button type="submit" class="btn btn-danger font-weight-bold px-4 py-2 shadow-sm">
                                        <i class="fas fa-lock mr-1"></i> Update Password
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<%- include('partials/footer') %>
