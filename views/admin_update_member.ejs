<%- include('partials/header', { title: 'শিক্ষার্থী তথ্য আপডেট (Update Student Profile)', activePage: 'admin_update_member' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="card shadow border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="page-title-banner">
                            <i class="fas fa-user-edit mr-2"></i> অ্যাডমিন: শিক্ষার্থী ও সদস্য তথ্য সংশোধন (Update Profile)
                        </div>

                        <!-- Top Search Student ID Bar -->
                        <form action="/admin_update_member.aspx" method="GET" class="my-4">
                            <div class="row justify-content-center">
                                <div class="col-md-6">
                                    <div class="input-group input-group-lg shadow-sm">
                                        <input type="text" name="roll" value="<%= typeof searchedRoll !== 'undefined' ? searchedRoll : '' %>" class="form-control" placeholder="স্টুডেন্ট আইডি বা রোল লিখুন (যেমন: 200101)" required />
                                        <div class="input-group-append">
                                            <button class="btn btn-emerald font-weight-bold px-4" type="submit">
                                                <i class="fas fa-search mr-1"></i> সার্চ করুন
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <% if (typeof member !== 'undefined' && member) { %>
                            <!-- Student Edit Form -->
                            <form action="/admin_update_member.aspx" method="POST">
                                <input type="hidden" name="roll_no" value="<%= member.student_id || member.roll_no %>" />

                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom pb-2 mb-3">
                                    <h5 class="font-weight-bold text-primary m-0">
                                        <i class="fas fa-user-graduate mr-2"></i> এডিট করা হচ্ছে: <%= member.full_name %> (আইডি: <%= member.student_id || member.roll_no %>)
                                    </h5>
                                    <div class="mt-2 mt-md-0">
                                        <label class="font-weight-bold mr-2 mb-0">ভেরিফিকেশন স্ট্যাটাস:</label>
                                        <select name="status" class="form-control d-inline-block w-auto font-weight-bold">
                                            <option value="Active" <%= member.status === 'Active' ? 'selected' : '' %>>সক্রিয় (Active)</option>
                                            <option value="Pending" <%= member.status === 'Pending' ? 'selected' : '' %>>পেন্ডিং ভেরিফিকেশন (Pending)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group">
                                        <label class="font-weight-bold">পূর্ণ নাম (Full Name)</label>
                                        <input name="full_name" type="text" class="form-control" value="<%= member.full_name %>" required />
                                    </div>
                                    <div class="col-md-3 form-group">
                                        <label class="font-weight-bold">রক্তের গ্রুপ</label>
                                        <input name="blood_group" type="text" class="form-control" value="<%= member.blood_group %>" />
                                    </div>
                                    <div class="col-md-3 form-group">
                                        <label class="font-weight-bold">উপজেলা</label>
                                        <select name="upazila" class="form-control">
                                            <option value="Chapainawabganj Sadar" <%= member.upazila === 'Chapainawabganj Sadar' ? 'selected' : '' %>>চাঁপাইনবাবগঞ্জ সদর</option>
                                            <option value="Shibganj" <%= member.upazila === 'Shibganj' ? 'selected' : '' %>>শিবগঞ্জ</option>
                                            <option value="Gomostapur" <%= member.upazila === 'Gomostapur' ? 'selected' : '' %>>গোমস্তাপুর</option>
                                            <option value="Nachole" <%= member.upazila === 'Nachole' ? 'selected' : '' %>>নাচোল</option>
                                            <option value="Bholahat" <%= member.upazila === 'Bholahat' ? 'selected' : '' %>>ভোলাহাট</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group">
                                        <label class="font-weight-bold">ইমেইল ঠিকানা</label>
                                        <input name="email" type="email" class="form-control" value="<%= member.email %>" required />
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label class="font-weight-bold">মোবাইল নম্বর</label>
                                        <input name="contact_number" type="text" class="form-control" value="<%= member.contact_number %>" required />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group">
                                        <label class="font-weight-bold">বিভাগ (Department)</label>
                                        <input name="department" type="text" class="form-control" value="<%= member.department %>" required />
                                    </div>
                                    <div class="col-md-3 form-group">
                                        <label class="font-weight-bold">সেশন (Session)</label>
                                        <input name="session" type="text" class="form-control" value="<%= member.session %>" required />
                                    </div>
                                    <div class="col-md-3 form-group">
                                        <label class="font-weight-bold">বর্তমান পেশা / অবস্থান</label>
                                        <input name="profession" type="text" class="form-control" value="<%= member.profession %>" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group">
                                        <label class="font-weight-bold">পাবনায় হল / মেস</label>
                                        <input name="hall" type="text" class="form-control" value="<%= member.hall %>" />
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label class="font-weight-bold">বর্তমান পূর্ণ ঠিকানা</label>
                                        <input name="present_address" type="text" class="form-control" value="<%= member.present_address %>" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group">
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" name="is_blood_donor" id="adminDonorCheck" value="yes" <%= member.is_blood_donor ? 'checked' : '' %> />
                                            <label class="form-check-label font-weight-bold" for="adminDonorCheck">
                                                জরুরি রক্তদাতা নেটওয়ার্কে অন্তর্ভুক্ত
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label class="font-weight-bold text-danger">পাসওয়ার্ড রিসেট (ঐচ্ছিক)</label>
                                        <input name="new_password" type="text" class="form-control" placeholder="নতুন পাসওয়ার্ড দিন (অপরিবর্তিত রাখতে খালি রাখুন)" />
                                    </div>
                                </div>

                                <div class="text-center mt-4">
                                    <button type="submit" class="btn btn-emerald btn-lg px-5 shadow font-weight-bold">
                                        <i class="fas fa-save mr-2"></i> তথ্য সংরক্ষণ ও আপডেট করুন
                                    </button>
                                </div>
                            </form>
                        <% } else if (typeof searchedRoll !== 'undefined' && searchedRoll) { %>
                            <div class="alert alert-warning text-center my-4">
                                <i class="fas fa-exclamation-circle mr-2"></i> স্টুডেন্ট আইডি বা রোল: <strong><%= searchedRoll %></strong> এর কোনো শিক্ষার্থীর রেকর্ড পাওয়া যায়নি।
                            </div>
                        <% } else { %>
                            <div class="text-center text-muted my-5">
                                <i class="fas fa-search fa-3x mb-3 text-secondary"></i>
                                <h5>উপরে শিক্ষার্থীর স্টুডেন্ট আইডি বা রোল লিখে সার্চ করুন এবং তথ্য সংশোধন করুন।</h5>
                            </div>
                        <% } %>

                    </div>
                    <div class="card-footer bg-white border-0 pb-4 pl-4">
                        <a href="/membermanagement.aspx" class="text-primary font-weight-bold">&lt;&lt; শিক্ষার্থী তালিকায় ফিরে যান</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
