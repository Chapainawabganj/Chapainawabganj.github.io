<%- include('partials/header', { title: 'ডাউনলোড ও ডকুমেন্টস (Downloads)', activePage: 'download' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="page-title-banner">
                            <i class="fas fa-file-download mr-2"></i> ডাউনলোড ও প্রকাশনা - চাঁপাইনবাবগঞ্জ জেলা সমিতি, পাবিপ্রবি
                        </div>

                        <div class="table-responsive mt-4">
                            <table class="table table-hover table-bordered datatable" style="width: 100%;">
                                <thead style="background-color: var(--navy-blue); color: white;">
                                    <tr>
                                        <th class="align-middle">ডকুমেন্ট ও ফাইলের নাম</th>
                                        <th class="text-center align-middle" style="width: 160px;">প্রকাশের তারিখ</th>
                                        <th class="text-center align-middle" style="width: 180px;">ডাউনলোড অ্যাকশন</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (downloads && downloads.length > 0) { %>
                                        <% downloads.forEach(function(item) { %>
                                            <tr>
                                                <td class="align-middle font-weight-bold text-dark">
                                                    <i class="fas fa-file-pdf text-danger mr-2"></i> <%= item.title %>
                                                </td>
                                                <td class="text-center align-middle text-muted">
                                                    <%= item.date || 'N/A' %>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <a href="/<%= item.file_url %>" class="btn btn-emerald btn-sm px-3 shadow-sm font-weight-bold" target="_blank" download>
                                                        <i class="fas fa-download mr-1"></i> ডাউনলোড করুন
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="3" class="text-center py-4 text-muted">বর্তমানে কোনো ফাইল পাওয়া যায়নি।</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <div class="card-footer bg-white border-0 pb-4 pl-4">
                        <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; হোমে ফিরে যান</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
