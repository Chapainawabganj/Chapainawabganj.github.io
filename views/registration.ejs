<%- include('partials/header', { title: 'Apply for Membership', activePage: 'registration' }) %>

<section class="content my-4">
    <div class="container-fluid px-lg-5">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="page-title-banner">
                            PUST EEE ALUMNI MEMBERSHIP REGISTRATION
                        </div>

                        <p class="text-center text-muted mb-4">
                            Please fill out all the information accurately. After submitting, your application will be reviewed and verified by the administration.
                        </p>

                        <form action="/registration.aspx" method="POST" enctype="multipart/form-data" id="registrationForm">

                            <!-- Section 1: Personal Details -->
                            <h5 class="font-weight-bold text-primary border-bottom pb-2 mb-3">
                                <i class="fas fa-user mr-2"></i> 1. Personal Information
                            </h5>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Full Name <span class="text-danger">*</span></label>
                                    <input name="full_name" type="text" class="form-control" placeholder="Full Name" required />
                                </div>
                                <div class="col-md-3 form-group">
                                    <label class="font-weight-bold">Gender <span class="text-danger">*</span></label>
                                    <select name="gender" class="form-control" required>
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>
                                <div class="col-md-3 form-group">
                                    <label class="font-weight-bold">Blood Group</label>
                                    <select name="blood_group" class="form-control">
                                        <option value="">Select Blood Group</option>
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Email Address <span class="text-danger">*</span></label>
                                    <input name="email" type="email" class="form-control" placeholder="Email Address" required />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Contact Number <span class="text-danger">*</span></label>
                                    <input name="contact_number" type="text" class="form-control" placeholder="+8801XXXXXXXXX" required />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Facebook Profile Link</label>
                                    <input name="facebook" type="url" class="form-control" placeholder="https://facebook.com/username" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">LinkedIn Profile Link</label>
                                    <input name="linkedin" type="url" class="form-control" placeholder="https://linkedin.com/in/username" />
                                </div>
                            </div>

                            <!-- Section 2: Academic Details -->
                            <h5 class="font-weight-bold text-primary border-bottom pb-2 mt-4 mb-3">
                                <i class="fas fa-graduation-cap mr-2"></i> 2. Academic Information
                            </h5>

                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Roll No. <span class="text-danger">*</span></label>
                                    <input name="roll_no" type="text" class="form-control" placeholder="e.g. 090201" required />
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Batch No. <span class="text-danger">*</span></label>
                                    <select name="batch_no" class="form-control" required>
                                        <option value="">Select Batch</option>
                                        <option value="1st">1st Batch</option>
                                        <option value="2nd">2nd Batch</option>
                                        <option value="3rd">3rd Batch</option>
                                        <option value="4th">4th Batch</option>
                                        <option value="5th">5th Batch</option>
                                        <option value="6th">6th Batch</option>
                                        <option value="7th">7th Batch</option>
                                        <option value="8th">8th Batch</option>
                                        <option value="9th">9th Batch</option>
                                        <option value="10th">10th Batch</option>
                                        <option value="11th">11th Batch</option>
                                        <option value="12th">12th Batch</option>
                                        <option value="13th">13th Batch</option>
                                        <option value="14th">14th Batch</option>
                                    </select>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Degree <span class="text-danger">*</span></label>
                                    <select name="degree" class="form-control" required>
                                        <option value="">Select Degree</option>
                                        <option value="B.Sc in EEE">B.Sc in EEE</option>
                                        <option value="M.Sc. Engineering">M.Sc. Engineering</option>
                                        <option value="B.Sc in EEE, M.Sc in Computer Science">B.Sc in EEE, M.Sc in Computer Science & ACMP IBA DU</option>
                                        <option value="M.Phil.">M.Phil.</option>
                                        <option value="Ph.D.">Ph.D.</option>
                                        <option value="Other higher degrees">Other higher degrees</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Department <span class="text-danger">*</span></label>
                                    <input name="department" type="text" class="form-control" value="Electrical and Electronic Engineering (EEE)" readonly />
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Residential Hall</label>
                                    <select name="hall" class="form-control">
                                        <option value="">Select Hall</option>
                                        <option value="Bangabandhu Sheikh Mujibur Rahman hall">Bangabandhu Sheikh Mujibur Rahman hall</option>
                                        <option value="Sheikh Rasel Hall">Sheikh Rasel Hall</option>
                                        <option value="Sheikh Hasina hall">Sheikh Hasina hall</option>
                                        <option value="Sheikh Fajilatunnesa Mujib Hall">Sheikh Fajilatunnesa Mujib Hall</option>
                                    </select>
                                </div>
                                <div class="col-md-2 form-group">
                                    <label class="font-weight-bold">Passing Year</label>
                                    <input name="passing_year" type="text" class="form-control" placeholder="e.g. 2014" />
                                </div>
                                <div class="col-md-2 form-group">
                                    <label class="font-weight-bold">Grade/CGPA</label>
                                    <input name="grade_cgpa" type="text" class="form-control" placeholder="e.g. 3.75" />
                                </div>
                            </div>

                            <!-- Section 3: Professional & Address Details -->
                            <h5 class="font-weight-bold text-primary border-bottom pb-2 mt-4 mb-3">
                                <i class="fas fa-building mr-2"></i> 3. Professional &amp; Address Information
                            </h5>

                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Current Organization</label>
                                    <input name="organization" type="text" class="form-control" placeholder="Company / Institution" />
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Last Position / Designation</label>
                                    <input name="designation" type="text" class="form-control" placeholder="e.g. Senior Engineer" />
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Work / Present Country</label>
                                    <input name="work_country" type="text" class="form-control" value="Bangladesh" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Permanent District &amp; Address</label>
                                    <input name="permanent_district" type="text" class="form-control mb-2" placeholder="Permanent District (e.g. Pabna)" />
                                    <textarea name="permanent_address" rows="2" class="form-control" placeholder="Full Permanent Address"></textarea>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Present District &amp; Address</label>
                                    <input name="present_district" type="text" class="form-control mb-2" placeholder="Present District (e.g. Dhaka)" />
                                    <textarea name="present_address" rows="2" class="form-control" placeholder="Full Present / Working Address"></textarea>
                                </div>
                            </div>

                            <!-- Section 4: Membership, Documents & Payment -->
                            <h5 class="font-weight-bold text-primary border-bottom pb-2 mt-4 mb-3">
                                <i class="fas fa-id-card mr-2"></i> 4. Membership, Documents &amp; Payment
                            </h5>

                            <div class="row">
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Membership Type <span class="text-danger">*</span></label>
                                    <select name="membership_type" class="form-control" required>
                                        <option value="Member">Member</option>
                                        <option value="Fellow">Fellow</option>
                                        <option value="Associate member">Associate member</option>
                                        <option value="Certified">Certified</option>
                                    </select>
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Membership No. (Optional)</label>
                                    <input name="membership_no" type="text" class="form-control" placeholder="Auto-generated if blank" />
                                </div>
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Certificate Serial No.</label>
                                    <input name="cert_serial_no" type="text" class="form-control" placeholder="Certificate Serial No." />
                                </div>
                            </div>

                            <div class="row align-items-center mb-3">
                                <div class="col-md-4 form-group">
                                    <label class="font-weight-bold">Profile Photo <span class="text-danger">*</span></label>
                                    <input type="file" name="profile_photo" class="form-control-file" accept="image/*" onchange="previewImage(this, 'imgview');" required />
                                    <small class="text-muted">JPG or PNG format</small>
                                </div>
                                <div class="col-md-2 text-center">
                                    <img id="imgview" src="/Photo/fahim.png" alt="Preview" class="rounded border p-1" style="height: 80px; width: 80px; object-fit: cover;" />
                                </div>
                                <div class="col-md-3 form-group">
                                    <label class="font-weight-bold">Degree Certificate</label>
                                    <input type="file" name="cert_photo" class="form-control-file" accept="image/*,.pdf" />
                                </div>
                                <div class="col-md-3 form-group">
                                    <label class="font-weight-bold">Payment Method <span class="text-danger">*</span></label>
                                    <select name="payment_method" class="form-control" required>
                                        <option value="Online Payment">Online Payment (bKash / Nagad / Rocket)</option>
                                        <option value="Bank Recept">Bank Receipt / Deposit</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Payment Slip / Screenshot</label>
                                    <input type="file" name="payment_photo" class="form-control-file" accept="image/*,.pdf" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold">Choose a Password for Login <span class="text-danger">*</span></label>
                                    <input name="password" type="password" class="form-control" placeholder="Minimum 6 characters" minlength="6" required />
                                </div>
                            </div>

                            <!-- Terms and Submit -->
                            <div class="form-group my-4 p-3 bg-light rounded border">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="agreeTerms" name="terms" value="agree" required />
                                    <label class="form-check-label font-weight-bold" for="agreeTerms">
                                        I hereby declare that all the information provided above is true and correct to the best of my knowledge, and I agree to abide by the constitution and rules of PUST EEE Alumni Association.
                                    </label>
                                </div>
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-success btn-lg px-5 shadow font-weight-bold" style="height: 50px;">
                                    <i class="fas fa-paper-plane mr-2"></i> Submit Application
                                </button>
                            </div>

                        </form>

                    </div>
                    <div class="card-footer bg-white border-0 pb-4 pl-4">
                        <a href="/home.aspx" class="text-primary font-weight-bold">&lt;&lt; Back to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function previewImage(input, previewId) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#' + previewId).attr('src', e.target.result);
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

<%- include('partials/footer') %>
